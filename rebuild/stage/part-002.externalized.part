  overscroll-behavior-y:auto !important;
  touch-action:pan-x pan-y !important;
}
</style>

<style id="hellfireHoundPortraitFix">
/* Targeted art placement fix so Hellfire Hound shows the hound more clearly. */
.demon[data-key="beast_hound"] .demonArt{
  height:150% !important;
  object-position:center 8% !important;
  margin-top:0 !important;
}
@media(max-width:700px){
  .demon[data-key="beast_hound"] .demonArt{
    height:150% !important;
    object-position:center 6% !important;
    margin-top:0 !important;
  }
}
</style>

<style id="targetedPortraitOffsets">
/* Move selected portraits upward by ~5% from the current placement. */
.demon[data-key="beast_moonfang"] .demonArt{margin-top:-11% !important;}
.demon[data-key="imp_carrion"] .demonArt{margin-top:-11% !important;}
.demon[data-key="beast_hound"] .demonArt{margin-top:-5% !important;}
@media(max-width:700px){
  .demon[data-key="beast_moonfang"] .demonArt{margin-top:-13% !important;}
  .demon[data-key="imp_carrion"] .demonArt{margin-top:-13% !important;}
  .demon[data-key="beast_hound"] .demonArt{margin-top:-5% !important;}
}
</style>

<style id="standaloneRoomArtworkEmbeddedSharp">
/* Definitive compressed high-resolution embedded room artwork. */
.room.gateway{background-image:linear-gradient(rgba(8,8,10,.28),rgba(8,8,10,.28)),url("./assets/embedded/c2a344d9-76644.webp") !important;background-size:cover !important;background-position:center center !important;background-repeat:no-repeat !important;}
.room.hall{background-image:linear-gradient(rgba(8,8,10,.32),rgba(8,8,10,.32)),url("./assets/embedded/75b9c42a-109948.webp") !important;background-size:cover !important;background-position:center center !important;background-repeat:no-repeat !important;}
.room.chapel{background-image:linear-gradient(rgba(8,8,10,.28),rgba(8,8,10,.28)),url("./assets/embedded/077337c6-106892.webp") !important;background-size:cover !important;background-position:center center !important;background-repeat:no-repeat !important;}
.room.crypt{background-image:linear-gradient(rgba(8,8,10,.30),rgba(8,8,10,.30)),url("./assets/embedded/cd2c7e94-85940.webp") !important;background-size:cover !important;background-position:center center !important;background-repeat:no-repeat !important;}
.room.boss{background-image:linear-gradient(rgba(8,8,10,.30),rgba(8,8,10,.30)),url("./assets/embedded/42ae99c1-94260.webp") !important;background-size:cover !important;background-position:center center !important;background-repeat:no-repeat !important;}
</style>

<style id="priestCardArtworkStyles">
.hand .card{min-height:292px;padding:8px 8px 44px;display:flex;flex-direction:column;gap:4px;overflow:hidden}
.hand .card .cardArt{height:102px;margin:-8px -8px 6px;background-size:cover;background-position:center;border-bottom:1px solid #8a6630;border-radius:7px 7px 0 0;box-shadow:inset 0 -28px 34px rgba(0,0,0,.26);position:relative;overflow:hidden}
.hand .card .cardArt::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(0,0,0,.16));pointer-events:none}
.hand .card .cardArt.divineWrathArt{background-position:center 45% !important}
.hand .card .cost{top:10px;right:9px;z-index:3}
.hand .card h4{margin:0 34px 4px 0;font-size:13px;line-height:1.15}
.hand .card p{font-size:10.7px;line-height:1.23;margin:3px 0}
.hand .card .actions{position:absolute;left:7px;right:7px;bottom:2px;display:flex;gap:5px;margin:0;z-index:4}
.hand .card .actions button{flex:1;min-width:0}
.hand .card .empoweredTag{align-self:flex-start}
@media(max-width:700px){.hand .card{min-height:306px;padding-bottom:50px}.hand .card .cardArt{height:118px}.hand .card .actions{bottom:8px}}
</style>


<style id="priestCardTextTexturePatch2">
.hand .card{
  background:linear-gradient(180deg,#ead5aa 0%,#c79f63 100%) !important;
  color:#24170d;
  min-height:278px;
  padding-bottom:8px;
}
.hand .card .cardBottom{
  position:relative;
  flex:1 1 auto;
  display:flex;
  flex-direction:column;
  justify-content:flex-start;
  min-height:0;
  margin:0 -8px -8px;
  padding:8px 8px 44px;
  border-radius:0 0 7px 7px;
  background-image:linear-gradient(rgba(245,233,208,.18),rgba(171,126,68,.46)), url('./assets/embedded/91fe8161-12672.webp');
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  background-blend-mode:multiply;
  border-top:1px solid rgba(111,78,30,.42);
  overflow:hidden;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.24), inset 0 16px 24px rgba(120,85,35,.14), inset 0 0 44px rgba(84,54,18,.36), 0 0 0 1px rgba(95,67,28,.22);
}
.hand .card .cardBottom::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:0;
  background:
    radial-gradient(circle at 12% 18%, rgba(98,63,27,.18) 0%, rgba(98,63,27,0) 26%),
    radial-gradient(circle at 83% 22%, rgba(76,46,16,.14) 0%, rgba(76,46,16,0) 24%),
    radial-gradient(circle at 24% 78%, rgba(135,98,50,.16) 0%, rgba(135,98,50,0) 22%),
    radial-gradient(circle at 76% 82%, rgba(89,56,21,.12) 0%, rgba(89,56,21,0) 20%),
    linear-gradient(90deg, rgba(81,51,19,.14) 0%, rgba(81,51,19,0) 8%, rgba(81,51,19,0) 92%, rgba(81,51,19,.14) 100%),
    linear-gradient(180deg, rgba(255,249,234,.05) 0%, rgba(0,0,0,0) 16%, rgba(0,0,0,0) 84%, rgba(77,49,17,.12) 100%);
}
.hand .card .cardBottom::after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:0;
  background:linear-gradient(135deg, rgba(255,255,255,.05), rgba(255,255,255,0) 18%, rgba(77,47,15,.06) 60%, rgba(77,47,15,.10));
  mix-blend-mode:multiply;
}
.hand .card .cardBottom > *{
  position:relative;
  z-index:1;
}
.hand .card .cardArt{
  margin:-8px -8px 0;
}
.hand .card h4{
  margin:0 34px 4px 0;
}
.hand .card .cardBottom p:last-of-type{margin-bottom:0}
.hand .card .actions{position:absolute;left:7px;right:7px;bottom:7px;display:flex;gap:5px;margin:0;z-index:4}
.hand .card .cardBottom .actions{left:8px;right:8px;bottom:2px}
.hand .card .actions button{flex:1;min-width:0}
.hand .card .cardArt.divineWrathArt{background-position:center 50% !important}
@media(max-width:700px){
  .hand .card{min-height:290px}
  .hand .card .cardBottom{padding-bottom:46px}
}
</style>


<style id="visualDamageTargetStyles">
.choicegrid.damageTargetGrid{
  display:grid;
  grid-template-columns:repeat(auto-fill,150px);
  justify-content:center;
  align-items:start;
  gap:7px;
}
.choice.damageTargetCard{
  width:150px;
  min-height:0;
  box-sizing:border-box;
  margin:0;
  padding:5px;
  overflow:hidden;
  border:1px solid #644036;
  border-radius:7px;
  background:linear-gradient(180deg,#271717,#1a1011);
  color:#eadbbf;
  box-shadow:inset 0 0 10px rgba(0,0,0,.32);
  display:flex;
  flex-direction:column;
  gap:6px;
  cursor:pointer;
  text-align:left;
  transform:none;
}
.choice.damageTargetCard.greater{
  background:linear-gradient(180deg,#311a10,#21120e);
  border-color:#a9682e;
}
.choice.damageTargetCard:hover{
  background:linear-gradient(180deg,#321a1a,#201011);
  border-color:#b47b3d;
  transform:none;
}
.choice.damageTargetCard .demonArtWrap{
  width:100%;
  height:92px;
  overflow:hidden;
  border:1px solid #8b6737;
  border-radius:6px;
  flex:none;
  background:#120d0d;
  box-shadow:inset 0 0 14px rgba(0,0,0,.45);
}
.choice.damageTargetCard .demonArt{
  display:block;
  width:100%;
  height:170%;
  object-fit:cover;
  object-position:center 28%;
  margin-top:-6%;
  filter:saturate(1.02) contrast(1.03);
}
.choice.damageTargetCard .demonBody{
  min-width:0;
  flex:1;
  display:flex;
  flex-direction:column;
  gap:4px;
}
.choice.damageTargetCard .name{
  color:#f1d5a4;
  font-weight:bold;
  line-height:1.1;
  font-size:11px;
}
.choice.damageTargetCard .demonStats{
  display:flex;
  flex-wrap:wrap;
  gap:3px 4px;
  font-size:9.5px;
  line-height:1.2;
}
.choice.damageTargetCard .demonStats span{
  display:inline-block;
  padding:1px 4px;
  border:1px solid #5e4a35;
  border-radius:999px;
  background:rgba(0,0,0,.18);
}
.choice.damageTargetCard .hp{color:#ff8585}
.choice.damageTargetCard .blood{color:#df3f48}
.choice.damageTargetCard .attack{color:#e4c17a}
.choice.damageTargetCard .familyTag{
  display:inline-block;
  align-self:flex-start;
  margin:0;
  padding:1px 5px;
  border:1px solid #614d33;
  border-radius:999px;
  color:#cdb783;
  font-size:8px;
  letter-spacing:.6px;
  text-transform:uppercase;
}
.choice.damageTargetCard .targetRoomTag{
  color:#ad9b7d;
  font-size:8px;
  letter-spacing:.55px;
  text-transform:uppercase;
  line-height:1.15;
}
.choice.damageTargetCard .abilityText{
  font-size:10px;
  line-height:1.32;
  color:#e5d9c7;
  margin-top:1px;
  white-space:normal;
  overflow-wrap:anywhere;
}
.choice.damageTargetCard.bossTarget{
  width:190px;
  border-color:#984038;
  background:linear-gradient(180deg,#2a1010,#1a0b0b);
}
.choice.damageTargetCard.bossTarget .demonArtWrap{height:105px;border-color:#a26d35}
.choice.damageRoomChoice{width:170px;min-height:112px;display:flex;flex-direction:column;justify-content:center;gap:8px;text-align:center;border:2px solid #76562c;background:linear-gradient(180deg,#1c1516,#0d0c0e);color:#ecd29a;border-radius:10px;padding:12px;cursor:pointer}.choice.damageRoomChoice b{font-size:15px;letter-spacing:.8px;text-transform:uppercase}.choice.damageRoomChoice small{display:block;color:#bca98a;font-size:10px;line-height:1.35}.choice.damageRoomChoice:hover{filter:brightness(1.12)}

.choice.damageTargetDone{
  width:150px;
  min-height:90px;
  display:grid;
  place-items:center;
  text-align:center;
  border:1px dashed #7d6744;
  background:#19140f;
  color:#e3c88e;
  font-weight:700;
}
@media(max-width:700px){
  .choicegrid.damageTargetGrid{grid-template-columns:repeat(auto-fill,145px);gap:7px}
  .choice.damageTargetCard{width:145px}
  .choice.damageTargetCard.bossTarget{width:170px}
  .choice.damageTargetCard .demonArtWrap{height:112px}
  .choice.damageTargetCard .demonArt{height:175%;object-position:center 28%;margin-top:-8%}
  .choice.damageTargetCard .abilityText{font-size:10px}
  .choice.damageTargetCard .demonStats{font-size:10px}
  .choice.damageTargetDone{width:145px}
}
</style>


<style id="rogueliteOriginalArtStyles">
/* Roguelite systems intentionally inherit the original Sanctum palette and controls. */
.rogueHud{margin:8px 0 12px;display:grid;grid-template-columns:repeat(6,minmax(100px,1fr));gap:7px}
.rogueHudCard{position:relative;overflow:hidden;min-height:68px;padding:9px 10px;border:1px solid #654d32;border-radius:8px;background:linear-gradient(180deg,rgba(40,27,21,.96),rgba(18,13,13,.96));box-shadow:inset 0 0 20px rgba(0,0,0,.24);text-align:center}
.rogueHudCard::before{content:"";position:absolute;inset:0;border-top:2px solid rgba(190,137,65,.28);pointer-events:none}
.rogueHudCard b{display:block;color:#f0d59b;font-size:18px;line-height:1.05;margin-bottom:4px;text-shadow:0 1px 6px #000}
.rogueHudCard span{display:block;color:#a9977d;font-size:9px;letter-spacing:1px;text-transform:uppercase}
.rogueHudCard.route b{font-size:13px;line-height:1.15;padding-top:2px}
.rogueProgress{grid-column:1/-1;height:7px;border:1px solid #4b3929;border-radius:99px;overflow:hidden;background:#100c0c;margin-top:-2px}
.rogueProgressFill{height:100%;width:0;background:linear-gradient(90deg,#7c2b24,#c28b46);transition:width .25s ease}
.rogueModalBox{width:min(900px,95vw);max-height:88vh;overflow:auto;border-color:#795b35;background:radial-gradient(circle at 50% 0,rgba(98,54,27,.22),transparent 46%),linear-gradient(180deg,#1e1514,#100c0d)}
.rogueEyebrow{color:#b98a4e;font-size:10px;letter-spacing:2.2px;text-transform:uppercase;font-weight:800;margin-bottom:5px}
.rogueLead{color:#cdbb98;line-height:1.5;margin:0 0 14px}
.rogueChoiceGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.rogueChoice{position:relative;min-height:180px;padding:14px;border:1px solid #6e5334;border-radius:10px;background:linear-gradient(180deg,#261a17,#120e0e);color:#ead8b2;text-align:left;cursor:pointer;box-shadow:inset 0 0 24px rgba(0,0,0,.28);transition:transform .12s ease,filter .12s ease,border-color .12s ease}
.rogueChoice:hover{transform:translateY(-2px);filter:brightness(1.08);border-color:#aa7b3f}
.rogueChoice.elite{border-color:#903d37;background:linear-gradient(180deg,#321313,#150d0d)}
.rogueChoice.sanctuary{border-color:#77714b;background:linear-gradient(180deg,#242319,#11100d)}
.rogueChoice.boss{border-color:#a14a38;background:radial-gradient(circle at 50% 0,rgba(139,38,29,.3),transparent 45%),linear-gradient(180deg,#2c1110,#100a0a)}
.rogueChoice .nodeIcon{font-size:30px;line-height:1;margin-bottom:9px;filter:drop-shadow(0 2px 5px #000)}
.rogueChoice h3{margin:0 0 7px;color:#f0d59b;font-size:17px;letter-spacing:.4px}
.rogueChoice p{margin:0;color:#bca98a;font-size:12px;line-height:1.45}
.rogueChoice .nodeReward{display:block;margin-top:11px;padding-top:8px;border-top:1px solid rgba(139,106,62,.35);color:#dba75f;font-size:10px;text-transform:uppercase;letter-spacing:.8px}
.rogueDraftCard{padding:0;overflow:hidden;min-height:330px}
.rogueDraftArt{height:160px;background-size:cover;background-position:center 24%;border-bottom:1px solid #6d4d2d;box-shadow:inset 0 -20px 35px rgba(0,0,0,.4)}
.rogueDraftBody{padding:12px}
.rogueDraftCost{position:absolute;top:8px;right:8px;z-index:2;min-width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#1b2942;border:2px solid #8ba8db;color:#fff;font-weight:900;box-shadow:0 2px 8px #000}
.rogueDraftBody small{display:block;color:#9e8c72;margin-top:8px;line-height:1.35}
.legacyGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0}
.legacyItem{border:1px solid #614b33;border-radius:9px;background:#17110f;padding:12px}
.legacyItem h3{margin:0 0 4px;color:#ead19a;font-size:14px}.legacyItem p{margin:0 0 8px;color:#b8a68a;font-size:11px;line-height:1.4}
.legacyMeta{display:flex;gap:7px;flex-wrap:wrap;margin:9px 0 14px}.legacyMeta .badge{font-size:11px}
.rogueGuideList{display:grid;gap:8px;margin:12px 0}.rogueGuideStep{border-left:3px solid #8d6032;background:#171110;padding:9px 11px;color:#cdbb98;line-height:1.45}.rogueGuideStep b{color:#eed29a}
.rogueRunTag{display:inline-flex;align-items:center;gap:5px;margin-left:6px;padding:2px 7px;border:1px solid #76542e;border-radius:99px;color:#e1b76f;background:#1d130f;font-size:9px;letter-spacing:.8px;text-transform:uppercase;vertical-align:middle}
@media(max-width:760px){.rogueHud{grid-template-columns:repeat(2,minmax(0,1fr))}.rogueHudCard.route{grid-column:1/-1}.rogueChoiceGrid{grid-template-columns:1fr}.rogueChoice{min-height:140px}.legacyGrid{grid-template-columns:1fr}.rogueDraftCard{min-height:280px}.rogueDraftArt{height:135px}}
</style>


<style id="compactRogueliteHudPatch">
/* Compact roguelite HUD pass: preserve the original art/layout while folding run info into existing controls. */
.stats.compactRunStats{
  position:relative;
  grid-template-columns:repeat(6,minmax(0,1fr));
  padding-top:2px;
}
.legacyRoundStat{display:none!important}
.runProgressStat{display:flex;flex-direction:column;justify-content:center;min-width:0}
.runProgressPair{display:flex;align-items:center;justify-content:center;gap:3px;min-height:27px;margin-bottom:2px}
.runProgressChunk{display:grid;grid-template-columns:1fr;align-items:center;gap:0;white-space:nowrap;line-height:1}
.runProgressChunk em{font-style:normal;font-size:7px;letter-spacing:.6px;color:#96856d;font-weight:700}
.runProgressChunk strong{font-size:13px;line-height:1.05;color:#efd292;text-shadow:0 1px 5px #000}
.runProgressDivider{width:1px;height:22px;background:linear-gradient(transparent,#755832,transparent)}
.relicXpMeterStat{
  background:linear-gradient(180deg,#17120e,#0b0908)!important;
  border-color:#9b642f!important;
  box-shadow:inset 0 0 16px rgba(0,0,0,.48),0 0 6px rgba(207,108,24,.08)!important;
  isolation:isolate;
}
.relicXpMeterFill{
  background:
    radial-gradient(circle at 25% 18%,rgba(255,235,190,.7) 0 4%,rgba(255,235,190,0) 17%),
    linear-gradient(180deg,#ffb24a 0%,#e87b22 38%,#b84512 72%,#6d2309 100%);
  box-shadow:inset 0 5px 9px rgba(255,210,135,.28),0 -2px 7px rgba(241,126,34,.48);
}
.relicXpMeterFill::before{background:rgba(255,210,135,.82)}
.relicXpMeterStat #relicXpMeterValue{color:#fff0d2!important;text-shadow:0 1px 2px #341306,0 0 6px rgba(255,143,49,.55)}
.relicXpMeterStat span{color:#f1c28b!important;text-shadow:0 1px 2px #1e0e07}
.compactTimerStat{min-width:0;padding-left:4px;padding-right:4px}
.compactTimerStat b{font-size:18px}
.compactTimerStat span{font-size:9px;letter-spacing:.6px}
.rogueHud.rogueHudCompact{grid-template-columns:1fr;margin:5px 0 10px;gap:4px}
.rogueHudCompact .rogueHudCard.route{min-height:42px;padding:6px 9px;display:flex;align-items:center;justify-content:center;gap:8px}
.rogueHudCompact .rogueHudCard.route b{padding:0;margin:0;font-size:12px}
.rogueHudCompact .rogueHudCard.route span{font-size:8px}
.rogueHudCompact .rogueProgress{height:5px;margin-top:0}
.rogueDataGhost{display:none!important}
.cinderActionBadge{border-color:#70542e;background:linear-gradient(#261b12,#17110d)}
.cinderActionBadge b{color:#e7bd6d}
@media(max-width:760px){
  .stats.compactRunStats{grid-template-columns:repeat(3,minmax(0,1fr));padding-top:2px}
  .runProgressPair{gap:4px}
  .runProgressChunk{grid-template-columns:1fr;gap:0;line-height:1}
  .runProgressChunk em{font-size:7px}
  .runProgressChunk strong{font-size:13px}
  .compactTimerStat{padding-left:2px;padding-right:2px}
  .compactTimerStat b{font-size:16px}
  .compactTimerStat span{font-size:8px;letter-spacing:.25px}
  .rogueHud.rogueHudCompact{grid-template-columns:1fr}
}
@media(max-width:390px){
  .stats.compactRunStats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .runProgressChunk strong{font-size:12px}
}


/* Equal-size top HUD: all tracker boxes share the same grid width and height. */
.stats.compactRunStats{grid-template-columns:repeat(6,minmax(0,1fr))!important;align-items:stretch}
.stats.compactRunStats>.stat{min-width:0!important;min-height:50px!important;height:50px!important;padding:5px 4px!important}
.stats.compactRunStats .compactTimerStat{padding:5px 4px!important}
@media(max-width:900px){
  .stats.compactRunStats{grid-template-columns:repeat(3,minmax(0,1fr))!important}
  .stats.compactRunStats>.stat{min-height:46px!important;height:46px!important}
}
@media(max-width:520px){
  .stats.compactRunStats{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}

/* Route-bar cleanup: hide the encounter route strip and reclaim its vertical space. */
#rogueHud.rogueHudCompact{display:none!important;margin:0!important;height:0!important;min-height:0!important;padding:0!important;border:0!important;}
#handPanel{margin-top:8px!important;}
</style>


<style id="demonArtZoomOutPatch">
/* Demon artwork framing pass: show the creature instead of heavily cropping the image. */
.demonArtWrap{
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  background:radial-gradient(circle at 50% 40%,#241714 0%,#100b0b 72%,#070606 100%) !important;
}
.demonArt,
.choice.damageTargetCard .demonArt{
  width:100% !important;
  height:100% !important;
  object-fit:contain !important;
  object-position:center center !important;
  margin:0 !important;
  transform:scale(.96) !important;
  transform-origin:center center !important;
}
/* Override older per-demon crop nudges so every Demon starts from a full-body framing. */
.demon[data-key] .demonArt{
  margin:0 !important;
  object-position:center center !important;
}
.deckface{
  min-width:0;
}
.deckface img{
  width:100% !important;
  aspect-ratio:3/4 !important;
  height:auto !important;
  max-height:330px !important;
  object-fit:contain !important;
  object-position:center center !important;
  padding:3px !important;
  box-sizing:border-box !important;
  background:radial-gradient(circle at 50% 38%,#261815 0%,#100b0b 75%,#070606 100%) !important;
}
@media(max-width:700px){
  .demonArt,
  .choice.damageTargetCard .demonArt{
    height:100% !important;
    margin:0 !important;
    transform:scale(.96) !important;
    object-position:center center !important;
  }
  .deckface img{max-height:300px !important;}
}
</style>


<style id="ritualRollPopupStyles">
.ritualRollOverlay{position:fixed;inset:0;z-index:2600;background:rgba(4,3,6,.82);display:flex;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(3px)}
.ritualRollOverlay.hidden{display:none !important}
.ritualRollCard{width:min(94vw,560px);border:1px solid #8a6630;border-radius:20px;background:linear-gradient(180deg,#1a1310 0%,#0d0b11 100%);box-shadow:0 26px 90px rgba(0,0,0,.55), inset 0 0 0 1px rgba(255,221,170,.05);padding:20px 22px 18px;color:#f1ddba;text-align:center}
.ritualRollEyebrow{font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#bda683;margin-bottom:6px}
.ritualRollTitle{font-size:28px;line-height:1.08;font-weight:700;color:#f0d2a0;margin:0 0 4px}
.ritualRollSub{font-size:13px;color:#bfa783;margin:0 0 12px}
.ritualRollDieWrap{display:flex;justify-content:center;align-items:center;margin:6px 0 12px;min-height:286px;perspective:1000px}
.ritualRollDie{position:relative;width:260px;height:286px;transform-origin:center center;filter:drop-shadow(0 16px 28px rgba(0,0,0,.48));transition:transform .22s ease;transform-style:preserve-3d;will-change:transform}
.ritualRollDie svg{position:absolute;inset:0;width:100%;height:100%}
.ritualRollDie .dieGlow{filter:drop-shadow(0 0 16px rgba(255,255,255,.15))}
.ritualRollDieFaces{position:absolute;inset:0;pointer-events:none;font-family:Impact, Haettenschweiler, 'Arial Black', system-ui, sans-serif;font-style:italic;font-weight:900}
.ritualRollDieCenter{position:absolute;left:50%;top:47%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;min-width:88px;min-height:72px;font-family:Impact, Haettenschweiler, 'Arial Black', system-ui, sans-serif;font-size:68px;line-height:1;font-weight:900;color:#fff;letter-spacing:-1px;text-shadow:none;pointer-events:none;z-index:5}
.ritualRollFace{position:absolute;display:flex;align-items:center;justify-content:center;min-width:28px;min-height:22px;font-size:17px;line-height:1;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.2);transform:translate(-50%,-50%) rotate(-14deg);transition:all .12s ease;opacity:.98;letter-spacing:-.5px}
.ritualRollFace.active{font-size:17px;min-width:28px;min-height:22px;color:#fff;font-weight:900;text-shadow:0 1px 3px rgba(0,0,0,.2);z-index:2;transform:translate(-50%,-50%) rotate(-14deg)}
.ritualRollFace.slot1{left:50%;top:11%}
.ritualRollFace.slot2{left:34%;top:19%}
.ritualRollFace.slot3{left:50%;top:18%}
.ritualRollFace.slot4{left:66%;top:19%}
.ritualRollFace.slot5{left:25%;top:31%}
.ritualRollFace.slot6{left:38%;top:30%}
.ritualRollFace.slot7{left:62%;top:30%}
.ritualRollFace.slot8{left:75%;top:31%}
.ritualRollFace.slot9{left:17%;top:46%}
.ritualRollFace.slot10{left:31%;top:44%}
.ritualRollFace.slot11{left:50%;top:47%}
.ritualRollFace.slot12{left:69%;top:44%}
.ritualRollFace.slot13{left:83%;top:46%}
.ritualRollFace.slot14{left:25%;top:63%}
.ritualRollFace.slot15{left:38%;top:61%}
.ritualRollFace.slot16{left:62%;top:61%}
.ritualRollFace.slot17{left:75%;top:63%}
.ritualRollFace.slot18{left:34%;top:81%}
.ritualRollFace.slot19{left:50%;top:80%}
.ritualRollFace.slot20{left:66%;top:81%}
.ritualRollDie.rolling .ritualRollFace{transition:none}
.ritualRollDie.rolling{animation:ritualDieRollSpin 1.55s cubic-bezier(.18,.88,.18,1) both}
@keyframes ritualDieRollSpin{0%{transform:rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(.84)}18%{transform:rotateX(160deg) rotateY(180deg) rotateZ(100deg) scale(1.02)}38%{transform:rotateX(330deg) rotateY(380deg) rotateZ(220deg) scale(1.06)}58%{transform:rotateX(500deg) rotateY(560deg) rotateZ(360deg) scale(1)}78%{transform:rotateX(640deg) rotateY(720deg) rotateZ(470deg) scale(1.02)}100%{transform:rotateX(720deg) rotateY(720deg) rotateZ(540deg) scale(1)}}
.ritualRollResult{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;align-items:center;margin:2px 0 8px}
.ritualRollPill{display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:6px 18px;border-radius:999px;border:1px solid #6f5832;background:#19130f;color:#f1ddba;font-size:12px;font-weight:700;letter-spacing:.1px;white-space:nowrap}
.ritualRollPill.resultLesser{border-color:#815844;background:#281613;color:#efc2b6;min-width:220px}
.ritualRollPill.resultGreater{border-color:#85713a;background:#261f11;color:#ffe3a4;min-width:250px}
.ritualRollPill.resultNat20{border-color:#b89139;background:linear-gradient(180deg,#5a4315,#2b1f0d);color:#fff3c4;box-shadow:0 0 14px rgba(205,163,55,.2);min-width:250px}
.ritualRollHint{font-size:13px;line-height:1.35;color:#c7b398;margin:0 0 12px}
.ritualRollBtnRow{display:flex;justify-content:center}
.ritualRollBtnRow .btn{min-width:152px}

/* Ritual roll toast replaces the full-screen die popup */
.ritualRollOverlay{position:fixed;left:50%;bottom:122px;transform:translateX(-50%);z-index:2600;background:none;padding:0;display:block;pointer-events:none;backdrop-filter:none}
.ritualRollOverlay.hidden{display:none !important}
.ritualRollCard{width:auto;min-width:220px;max-width:min(72vw,420px);border:1px solid #8a6630;border-radius:18px;background:linear-gradient(180deg,rgba(26,19,16,.98) 0%, rgba(13,11,17,.98) 100%);box-shadow:0 18px 42px rgba(0,0,0,.55), inset 0 0 0 1px rgba(255,221,170,.05);padding:10px 18px 12px;color:#f1ddba;text-align:center}
.ritualRollEyebrow{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:#bda683;margin:0 0 2px}
.ritualRollTitle{font-size:14px;line-height:1.15;font-weight:700;color:#f0d2a0;margin:0 0 4px}
.ritualRollSub,.ritualRollDieWrap,.ritualRollResult,.ritualRollHint,.ritualRollBtnRow{display:none !important}
.ritualRollToastNumber{font-family:Impact, Haettenschweiler, 'Arial Black', system-ui, sans-serif;font-size:52px;line-height:1;font-weight:900;color:#fff3cf;letter-spacing:-1px;margin:0 0 4px;text-shadow:0 0 12px rgba(255,214,130,.18)}
.ritualRollToastMeta{font-size:12px;line-height:1.25;color:#d9c29e}
.ritualRollCard.is-final .ritualRollToastNumber{color:#fff}

</style>



</head>
<body>
<div id="gameStatusToast" class="gameStatusToast hidden" role="status" aria-live="polite"></div>
<div class="app">

  <section class="board" id="boardSection">
    <div class="room gateway"><h3>GATEWAY</h3><div class="roomMeta" id="roomMeta0"><div class="cap">Maximum 4 Demons</div><button class="btn" data-cons="0">Consecrate</button></div><div class="demons" id="room0"></div></div>
    <div class="room hall"><h3>HALL</h3><div class="roomMeta" id="roomMeta1"><div class="cap">Maximum 4 Demons</div><button class="btn" data-cons="1">Consecrate</button></div><div class="demons" id="room1"></div></div>
    <div class="room chapel"><h3>CHAPEL</h3><div class="roomMeta" id="roomMeta2"><div class="cap">Maximum 4 Demons</div><button class="btn" data-cons="2">Consecrate</button></div><div class="demons" id="room2"></div></div>
    <div class="room crypt"><h3>CRYPT</h3><div class="roomMeta" id="roomMeta3"><div class="cap">Maximum 4 Demons</div><button class="btn" data-cons="3">Consecrate</button></div><div class="demons" id="room3"></div></div>
    <div class="room boss"><h3>BOSS ROOM</h3><div id="bossArea"><div class="cap">The Boss awakens after the 13th base Demon is defeated.</div></div></div>
  </section>

  <section class="stats compactRunStats" id="topStatusBar">
    <div class="stat runProgressStat" aria-label="Passage, Act, Floor and Round">
      <div class="runProgressPair">
        <span class="runProgressChunk"><em>PASSAGE</em><strong id="roguePassage">1 / 5</strong></span>
        <span class="runProgressDivider" aria-hidden="true"></span>
        <span class="runProgressChunk"><em>ACT</em><strong id="rogueAct">1 / 3</strong></span>
        <span class="runProgressDivider" aria-hidden="true"></span>
        <span class="runProgressChunk"><em>FLOOR</em><strong id="rogueFloor">1 / 15</strong></span>
        <span class="runProgressDivider" aria-hidden="true"></span>
        <span class="runProgressChunk"><em>ROUND</em><strong id="roundStat">1</strong></span>
      </div>
      <span>Run Progress</span>
    </div>
    <div class="stat relicXpMeterStat meterStat" id="relicXpMeterStat" role="meter" aria-label="Relic XP" aria-valuemin="0" aria-valuemax="15" aria-valuenow="0">
      <div class="relicXpMeterFill meterFill" id="relicXpMeterFill"></div>
      <div class="meterGlass"></div>
      <b id="relicXpMeterValue">0 / 15</b>
      <span>Relic XP</span>
    </div>
    <div class="stat turnTimerStat meterStat compactTimerStat" id="turnTimerStat" role="meter" aria-label="Turn Timer" aria-valuemin="0" aria-valuemax="60" aria-valuenow="45">
      <div class="turnTimerFill meterFill" id="turnTimerFill"></div>
      <div class="meterGlass"></div>
      <b id="turnTimerStatValue">—</b>
      <span>Timer</span>
    </div>
    <div class="stat manaMeterStat meterStat" id="manaStatBox" role="meter" aria-label="Shared Mana" aria-valuemin="0" aria-valuemax="10" aria-valuenow="10">
      <div class="manaMeterFill" id="manaOrbFill"></div>
      <div class="manaMeterGlow"></div>
      <div class="meterGlass"></div>
      <b id="manaStat">10</b>
      <span>Shared Mana</span>
    </div>
    <div class="stat altarMeterStat meterStat" id="altarStatBox" role="meter" aria-label="Altar Protection" aria-valuemin="0" aria-valuemax="30" aria-valuenow="30">
      <div class="altarMeterFill meterFill" id="altarMeterFill"></div>
      <div class="meterGlass"></div>
      <b id="altarStat">30</b>
      <span>Altar Protection</span>
    </div>
    <div class="stat"><b id="defeatStat">0 / 13</b><span>Base Defeats</span></div>
  </section>


  <section class="rogueHud rogueHudCompact" id="rogueHud" aria-label="Roguelite encounter status">
    <div class="rogueHudCard route"><b id="rogueRoute">Standard Battle</b><span>Current Route</span></div>
    <span id="rogueRelicXp" class="rogueDataGhost" aria-hidden="true">0 / 15</span>
    <span id="rogueCinders" class="rogueDataGhost" aria-hidden="true">0</span>
    <span id="rogueLegacyCinders" class="rogueDataGhost" aria-hidden="true">0</span>
    <div class="rogueProgress"><div class="rogueProgressFill" id="rogueProgressFill"></div></div>
  </section>

  <section class="panel handPanel" id="handPanel">
    <div id="handContent">Start a new game to draw your Priest hand.</div>
  </section>

  <section class="ritualLogStage" id="mainSection">
    <section class="panel ritualPanel" id="ritualPanel">
      <div class="ritualMain" id="ritualContent">Start a new game to view your Rituals.</div>
    </section>
    <div class="panel" id="logPanel">
      <h3>Game Log</h3><div class="log" id="log"></div>
      <h3 style="margin-top:10px">Manual / Prototype Controls</h3>
      <div class="controls">
        <button class="btn" data-adjust="altar" data-val="1">Altar +1</button><button class="btn" data-adjust="altar" data-val="-1">Altar −1</button>
        <button class="btn" data-adjust="mana" data-val="1">Mana +1</button><button class="btn" data-adjust="mana" data-val="-1">Mana −1</button>
        <button class="btn" id="spawnBtn">Spawn Demon</button><button class="btn" id="crucifixBtn">Draw Crucifix</button>
        <button class="btn" id="damageBtn">Manual Damage</button><button class="btn" id="killBtn">Defeat Selected</button>
      </div>
    </div>
  </section>
  <section class="panel bottomInfo" id="infoSection">
    <h3>Sanctum of the Damned</h3>
    <div class="bottomSubtitle">Roguelite Edition • Original Art & Layout</div>
    <div class="installHint hidden" id="installHint"><b>Standalone file:</b> open this HTML directly in your browser. No server or additional folder is required.</div>
    <div class="notice"><b>Browser Edition:</b> optimized for desktop Chrome, Edge, Firefox, and Safari while retaining phone/tablet support. This build uses the 25 Demon types from the five Demon sheets we created (4 copies each) plus the official 10-card Boss Demon deck. Demon and Boss art, HP, Blood, and printed abilities are built into this single file. Compatible abilities resolve automatically. Demon Attack is now resolved when a Demon reaches the Altar: its current Attack becomes the base Altar loss, and Attack-based Demon abilities are applied automatically.</div>
    <div class="footer">Roguelite browser playtest • Original Sanctum artwork and board preserved • 15-floor runs • 3 Acts • Persistent Cinders • No install or server required</div>
  </section>
  <div class="titlebar" id="topMenuBar">
    <button class="btn menuToggleBtn" id="menuToggleBtn" type="button" aria-expanded="true" aria-controls="topToolbar">Hide Menu ▲</button>
    <div class="toolbar" id="topToolbar"><button class="btn" id="newGameBtn">New Game</button><button class="btn" id="saveBtn">Save</button><button class="btn" id="loadBtn">Load</button><button class="btn" id="pauseBtn">Pause</button><button class="btn" id="rulesBtn">Rules</button><button class="btn" id="demonDeckBtn">Demon Deck</button><button class="btn" id="bossDeckBtn">Boss Deck</button></div>
  </div>

  <nav class="mobileNav" aria-label="Game navigation">
    <button data-jump="top">⌂<span>Top</span></button>
    <button data-jump="boardSection">♜<span>Board</span></button>
    <button data-jump="ritualPanel">✦<span>Turn</span></button>
    <button id="mobilePauseMenuBtn" type="button">☰<span>Log</span></button>
    <button id="mobileFullscreenBtn" type="button" aria-label="Enter full screen" title="Full Screen">⛶<span>Full</span></button>
  </nav>
</div>

<div class="modal hidden" id="newGameConfirmModal" role="dialog" aria-modal="true" aria-labelledby="newGameConfirmTitle">
  <div class="modalbox" style="width:min(460px,94vw);text-align:center">
    <h2 id="newGameConfirmTitle">Start a New Game?</h2>
    <p style="color:#cdbb98;line-height:1.5">
      Your current run will stay intact until you actually press <b>Start Game</b> on the setup screen.
    </p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
      <button class="btn red" id="restartGameConfirmBtn" style="flex:1">Restart Game</button>
      <button class="btn" id="restartGameCancelBtn" style="flex:1">Cancel</button>
    </div>
  </div>
</div>

<div class="modal" id="setupModal">
  <div class="modalbox"><h2>Begin the Exorcism</h2><p>Choose 2–4 players and one unique character for each player.</p>
    <div class="setupOptionsRow"><label>Players: <select id="playerCount"><option>1</option><option>2</option><option>3</option><option>4</option></select></label><label>Turn Timer: <select id="turnTimerSelect" aria-label="Turn timer length"><option value="30">30 seconds</option><option value="45">45 seconds</option><option value="60" selected>60 seconds</option><option value="75">75 seconds</option><option value="90">90 seconds</option><option value="105">105 seconds</option><option value="120">2 minutes</option></select></label></div>
    <div class="setupgrid" id="setupPlayers"></div>
    <div class="notice">Prototype setup gives each player 4 starting Priest cards. Solo begins with 1 Demon in the Gateway; 2–4 players begin with 2.</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn green" id="startBtn" style="flex:1">Start Game</button>
      <button class="btn hidden" id="setupCancelBtn" style="flex:1">Cancel</button>
    </div>
  </div>
</div>
<div class="modal hidden" id="choiceModal"><div class="modalbox"><h3 id="choiceTitle">Choose</h3><div class="choicegrid" id="choiceGrid"></div><button class="btn" id="choiceCancel">Cancel</button></div></div>
<div class="modal hidden" id="damageAmountModal" role="dialog" aria-modal="true" aria-labelledby="damageAmountTitle"><div class="modalbox" style="width:min(420px,94vw)"><h3 id="damageAmountTitle">Manual Damage</h3><p id="damageAmountTarget" style="color:#cdbb98"></p><label for="damageAmountInput">Damage amount</label><input id="damageAmountInput" type="number" min="1" step="1" inputmode="numeric" value="1" style="width:100%;margin:8px 0 12px;background:#0e0d0d;color:white;border:1px solid #80643a;border-radius:7px;padding:10px;font-size:18px"><div style="display:flex;gap:8px"><button class="btn red" id="damageAmountApply" style="flex:1">Apply Damage</button><button class="btn" id="damageAmountCancel" style="flex:1">Cancel</button></div></div></div>
<div class="modal hidden" id="descendModal" role="dialog" aria-modal="true" aria-labelledby="descendTitle">
  <div class="modalbox descendBox">
    <div class="descendCard">
      <div class="descendEyebrow">Boss Defeated</div>
      <div class="descendTitle" id="descendTitle">The Sanctum Endures</div>
      <div class="descendBoss" id="descendBossName"></div>
      <div class="descendCount" id="descendBossCount">Bosses defeated this run: 1</div>
      <div class="descendText">End the run and save the Sanctum, or descend deeper. Descending keeps your Altar Protection, Priest hands, Demon Blood, Relics, Corruption, Consecration, Demon positions, and cumulative Boss-damage Relic progress. A new Boss immediately enters the Boss Room.</div>
      <div class="descendActions">
        <button class="btn red" id="descendFurtherBtn">Descend Further</button>
        <button class="btn green" id="saveSanctumBtn">Save the Sanctum</button>
      </div>
    </div>
  </div>
</div>

<div class="modal hidden" id="endRunStatsModal" role="dialog" aria-modal="true" aria-labelledby="endRunStatsTitle">
  <div class="modalbox endRunStatsBox">
    <div class="endRunStatsEyebrow" id="endRunStatsEyebrow">Run Complete</div>
    <h2 id="endRunStatsTitle">End of Run Statistics</h2>
    <div class="endRunOutcome" id="endRunOutcome">The Sanctum Endures</div>

    <div class="endRunDamageHero">
      <span>Total Damage Dealt</span>
      <b id="endRunTotalDamage">0</b>
      <small id="endRunDamageBreakdown">0 to Demons • 0 to Bosses</small>
    </div>

    <div class="endRunStatsGrid">
      <div class="endRunStat"><b id="endRunRound">1</b><span>Round Reached</span></div>
      <div class="endRunStat"><b id="endRunDemons">0</b><span>Demons Defeated</span></div>
      <div class="endRunStat"><b id="endRunGreater">0</b><span>Greater Demons Defeated</span></div>
      <div class="endRunStat"><b id="endRunBosses">0</b><span>Bosses Defeated</span></div>
      <div class="endRunStat"><b id="endRunRelics">0</b><span>Relics Recovered</span></div>
      <div class="endRunStat"><b id="endRunAltar">0</b><span>Altar Protection Remaining</span></div>
      <div class="endRunStat"><b id="endRunCards">0</b><span>Priest Cards Played</span></div>
      <div class="endRunStat"><b id="endRunRituals">0</b><span>Rituals Used</span></div>
      <div class="endRunStat"><b id="endRunNatural20s">0</b><span>Natural 20s</span></div>
    </div>

    <button class="btn green endRunStatsClose" id="endRunStatsClose">Close Statistics</button>
  </div>
</div>

<div class="modal hidden" id="relicModal" role="dialog" aria-modal="true" aria-labelledby="relicName">
  <div class="modalbox relicBox">
    <div class="relicCard">
      <div class="relicType">Relic Acquired</div>
      <div class="relicName" id="relicName">Relic</div>
      <div class="relicCategory" id="relicCategory">Sanctum Relic</div>
      <div class="relicEffect" id="relicEffect"></div>
      <div class="relicReason" id="relicReason"></div>
    </div>
    <button class="btn green relicClose" id="relicClose">Claim Relic</button>
  </div>
</div>
<div class="modal hidden" id="desecrationModal" role="dialog" aria-modal="true" aria-labelledby="desecrationTitle">
  <div class="modalbox desecrationBox">
    <h2 id="desecrationTitle">Desecrated Room</h2>
    <div class="desecrationRoomName" id="desecrationRoomName">Gateway</div>
    <div class="desecrationEffect" id="desecrationEffect"></div>
    <button class="btn desecrationClose" id="desecrationClose">Close</button>
  </div>
</div>
<div class="modal hidden" id="consecrateModal" role="dialog" aria-modal="true" aria-labelledby="consecrateTitle">
  <div class="modalbox consecrateBox">
    <h2 id="consecrateTitle">Consecrate Room</h2>
    <div class="consecrateSummary">
      <div class="consecrateRoomName" id="consecrateRoomName">Gateway</div>
      <div class="consecrateCost"><b>Cost:</b> 3 Shared Mana + 1 Demon Blood</div>
      <div class="consecrateEffect" id="consecrateEffect"></div>
      <div class="consecrateStatus" id="consecrateStatus"></div>
    </div>
    <div class="consecrateActions">
      <button class="btn green" id="consecratePlay">Play</button>
      <button class="btn" id="consecrateClose">Close</button>
    </div>
  </div>
</div>
<div class="modal hidden" id="crucifixModal" role="dialog" aria-modal="true" aria-labelledby="crucifixName">
  <div class="modalbox crucifixBox">
    <div class="crucifixCard" id="crucifixCard">
      <div class="crucifixType" id="crucifixType">Crucifix Event</div>
      <div class="crucifixName" id="crucifixName">Crucifix</div>
      <div class="crucifixEffect" id="crucifixEffect"></div>
      <div class="crucifixChoiceArea hidden" id="crucifixChoiceArea"></div>
      <div class="crucifixResult" id="crucifixResult"></div>
    </div>
    <button class="btn crucifixClose" id="crucifixClose">Close</button>
  </div>
</div>


<div class="modal hidden" id="cardRevealModal" role="dialog" aria-modal="true" aria-labelledby="cardRevealTitle">
  <div class="modalbox revealCardsBox">
    <h2 id="cardRevealTitle">Revealed Cards</h2>
    <p id="cardRevealSubtitle" class="revealCardsSubtitle"></p>
    <div id="cardRevealGrid" class="revealCardsGrid"></div>
    <div class="revealCardsActions"><button class="btn" id="cardRevealClose">Close</button></div>
  </div>
</div>

<div class="modal hidden" id="demonDeckModal"><div class="modalbox demonDeckBox"><h2>Created Demon Deck</h2><p>25 Demon types × 4 copies = 100-card digital Demon deck. Each row shows the normal face and its Greater face.</p><div id="demonDeckGrid" class="deckgrid"></div><button class="btn" id="demonDeckClose">Close</button></div></div>
<div class="modal hidden" id="bossDeckModal"><div class="modalbox bossDeckBox"><h2>Official Boss Demon Deck</h2><p>10 unique Boss Demons. The first is secretly drawn at setup and awakens after the 13th base Demon defeat. After defeating a Boss, you may end the run or Descend Further and immediately draw another Boss from the randomized Boss bag.</p><div id="bossDeckGrid" class="bossDeckGrid"></div><button class="btn" id="bossDeckClose">Close</button></div></div>
<div class="modal hidden" id="rulesModal"><div class="modalbox"><h2>Core Digital Rules</h2><div id="rulesText"></div><button class="btn" id="rulesClose">Close</button></div></div>



<!-- Roguelite system overlays. Combat board/art remains the original game. -->
<div class="modal hidden" id="rogueChoiceModal" role="dialog" aria-modal="true" aria-labelledby="rogueChoiceTitle">
  <div class="modalbox rogueModalBox">
    <div class="rogueEyebrow" id="rogueChoiceEyebrow">Roguelite</div>
    <h2 id="rogueChoiceTitle">Choose Your Path</h2>
    <p class="rogueLead" id="rogueChoiceText"></p>
    <div class="rogueChoiceGrid" id="rogueChoiceGrid"></div>
  </div>
</div>
<div class="modal hidden" id="rogueLegacyModal" role="dialog" aria-modal="true" aria-labelledby="rogueLegacyTitle">
  <div class="modalbox rogueModalBox">
    <div class="rogueEyebrow">Persistent Progression</div>
    <h2 id="rogueLegacyTitle">Legacy of the Sanctum</h2>
    <p class="rogueLead">Cinders are banked automatically after every 3 Acts. At that checkpoint you may buy Legacy upgrades, then continue the same run. Legacy upgrades remain permanent starting bonuses for future fresh runs.</p>
    <div class="legacyMeta" id="rogueLegacyMeta"></div>
    <div class="legacyGrid" id="rogueLegacyGrid"></div>
    <button class="btn" id="rogueLegacyClose">Close</button>
  </div>
</div>
<div class="modal hidden" id="rogueGuideModal" role="dialog" aria-modal="true" aria-labelledby="rogueGuideTitle">
  <div class="modalbox rogueModalBox">
    <div class="rogueEyebrow">Roguelite Run Guide</div>
    <h2 id="rogueGuideTitle">What Changed</h2>
    <div class="rogueGuideList">
      <div class="rogueGuideStep"><b>15 Floors • 3 Acts.</b> Floors 5, 10, and 15 are Boss floors. Your Altar, Blood, cards, Corruption, and Relics carry through the run.</div>
      <div class="rogueGuideStep"><b>Branching routes.</b> After combat you choose among Standard Battles, Elite Battles, Hellgate Swarms, and non-combat Sanctuaries.</div>
      <div class="rogueGuideStep"><b>Relics are Blood XP rewards.</b> Every Demon kill grants Relic XP equal to the Demon Blood earned from that kill. The first XP Relic costs 15 XP; each XP-earned Relic raises the next cost by 5.</div>
      <div class="rogueGuideStep"><b>Room reward Relics are bonus Relics.</b> If you clear a room and choose a Relic reward, it does not increase the XP required for your next XP-earned Relic.</div>
      <div class="rogueGuideStep"><b>Build during the run.</b> Rewards still include Priest-card drafts using the original card pool/art, recovery, Demon Blood, and bonus Relics.</div>
      <div class="rogueGuideStep"><b>Cinders bank every 3 Acts.</b> Defeat the third Boss of a cycle to secure the Cinders you earned, open the Legacy shop, then continue the same run at double the previous cycle difficulty.</div>
      <div class="rogueGuideStep"><b>Health rises with depth.</b> Enemy max HP gains +15% of base HP for every floor descended, stacking with the Ascension-cycle multiplier. Attack scaling remains tied to Ascension difficulty.</div>
      <div class="rogueGuideStep"><b>Original combat remains intact.</b> Rooms, Demon movement, Corruption, Consecration, Ritual rolls, Empowering, Relic effects, and Boss abilities still use the original systems. Demon kills no longer draw Crucifix cards.</div>
      <div class="rogueGuideStep"><b>Visual target popups for Priest cards.</b> Any Priest card that targets a Demon now opens the illustrated target popup, showing all current Demons on the board, and Boss illustrations whenever that card can legally target the Boss.</div>
    </div>
    <button class="btn green" id="rogueGuideClose">Return to the Sanctum</button>
  </div>
</div>

