  #tutorialTip{margin-top:9px;border-left:3px solid #9d7738;background:#15110e;padding:8px 9px;color:#cdbb98;font-size:11.5px;line-height:1.4;border-radius:4px}
  .tutorialCoachActions{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}
  .tutorialCoachActions .btn{min-height:38px;flex:1;min-width:95px;padding:7px 9px}
  #tutorialPracticeBtn{border-color:#4d7a58;background:linear-gradient(#355f42,#172b1e)}
  #tutorialResumeChip{
    position:fixed;z-index:185;left:16px;bottom:16px;border:1px solid #b88d45;background:#1a130d;color:#f1d39b;
    border-radius:999px;padding:10px 14px;box-shadow:0 4px 20px rgba(0,0,0,.55);cursor:pointer;font:inherit;
  }
  #tutorialResumeChip.hidden{display:none!important}
  #tutorialBuildBadge{border-color:#9a7438;background:linear-gradient(#49351d,#20160e);color:#f0d49a}
  .tutorialCloseX{border:0;background:transparent;color:#b7a58a;font-size:23px;line-height:1;cursor:pointer;padding:3px 8px}
  .tutorialCloseX:hover{color:#fff}
  @media(max-width:700px){
    .tutorialPillGrid{grid-template-columns:1fr}
    #tutorialCoach{left:8px;bottom:70px;width:calc(100vw - 16px);padding:11px}
    #tutorialStepTitle{font-size:18px}
