@media(max-width:1180px){
  #handContent .handCarousel.twoFrontMode{width:454px !important;grid-template-columns:30px minmax(0,386px) 30px !important;}
  #handContent .handCarousel.twoFrontMode .hand.carouselTrack{width:376px !important;max-width:376px !important;grid-template-columns:184px 184px !important;gap:8px !important;}
  #handContent .handCarousel.twoFrontMode .hand.carouselTrack > .card.carouselCard.is-center,
  #handContent .handCarousel.twoFrontMode .hand.carouselTrack > .card.carouselCard.is-right{width:184px !important;max-width:184px !important;min-width:184px !important;}
  #handContent > .relicSummary,#handContent > .notice{max-width:454px !important;}
}
@media(max-width:900px){
  #handPanel .handCharacterPriest{width:100% !important;justify-self:stretch !important;}
}
@media(max-width:560px){
  #handContent .handCarousel.twoFrontMode{width:100% !important;grid-template-columns:30px minmax(0,1fr) 30px !important;}
  #handContent .handCarousel.twoFrontMode .hand.carouselTrack{width:100% !important;max-width:100% !important;grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:6px !important;}
  #handContent .handCarousel.twoFrontMode .hand.carouselTrack > .card.carouselCard.is-center,
  #handContent .handCarousel.twoFrontMode .hand.carouselTrack > .card.carouselCard.is-right{width:100% !important;max-width:none !important;min-width:0 !important;}
  #handContent .handCarousel.twoFrontMode .carouselHint{display:none !important;}
}
</style>
<script id="twoFrontCardHandPatchScript">
(()=>{
  'use strict';
  function applyTwoFrontCards(){
    const wrap=document.querySelector('#handContent .handCarousel');
    const track=wrap?.querySelector('.hand.carouselTrack');
    if(!wrap||!track)return;
    wrap.classList.add('twoFrontMode');
    const cards=[...track.children].filter(el=>el.classList?.contains('carouselCard'));
    const center=cards.findIndex(c=>c.classList.contains('is-center'));
    const n=cards.length;
    if(center<0||!n)return;
    // The existing carousel already exposes the next card as is-right. Keep both front cards fully interactive.
    const right=cards.findIndex(c=>c.classList.contains('is-right'));
    const meta=wrap.querySelector('.carouselMeta');
    if(meta){
      const count=meta.querySelector('.carouselCount');
      if(count){
        const second=right>=0?right:center;
        count.innerHTML=n>1?`<b>${center+1} &amp; ${second+1}</b> / ${n}`:`<b>${center+1}</b> / ${n}`;
      }
      const hint=meta.querySelector('.carouselHint');
      if(hint)hint.textContent='Use ‹ › to rotate cards';
    }
  }
  const previousRenderPlayer=renderPlayer;
  renderPlayer=function(){const out=previousRenderPlayer();applyTwoFrontCards();return out};
  if(S?.started)applyTwoFrontCards();
  document.title='Sanctum of the Damned — Two-Card Hand Edition';
})();
</script>


