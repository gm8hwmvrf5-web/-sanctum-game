  justify-content:flex-start !important;
  padding-left:185px;
  margin-top:-17px !important;
}
#handContent .handCarousel .carouselHint{display:none !important;}
#handContent > .relicSummary,
#handContent > .notice{max-width:568px;}
#handPanel .handCharacterPriest .ritualTracker{
  gap:5px;
  padding:0 0 7px;
  margin-bottom:7px;
}
#handPanel .handCharacterPriest .ritualTracker .badge{font-size:10px;padding:3px 6px;}
#handPanel .handCharacterPriest .ritualTracker .trackerAction{font-size:9.5px;padding:5px 8px;}
#handPanel .handCharacterPriest .playerTurnTag{margin-left:auto;}
#handPanel .handCharacterPriest .ritualMain h3{font-size:16px;margin:6px 0;}
#handPanel .handCharacterPriest .rituals{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;}
#handPanel .handCharacterPriest .ritual{min-height:156px;font-size:10px;padding:6px;}
#handPanel .handCharacterPriest .ritual small{font-size:9px;line-height:1.2;}
#handPanel .handCharacterPriest .ritual .btn{min-height:30px;font-size:9px;padding:4px 6px;}
#mainSection{grid-template-columns:1fr !important;margin-top:10px;}
#mainSection #logPanel{width:100%;}
@media(max-width:1180px){
  #handPanel .handCharacterStage{grid-template-columns:minmax(430px,520px) minmax(0,1fr);gap:9px;}
  #handContent .handCarousel{width:500px !important;grid-template-columns:30px minmax(0,436px) 30px !important;}
  #handContent .hand.carouselTrack{width:436px !important;max-width:436px !important;grid-template-columns:128px 180px 128px !important;}
  #handContent .hand.carouselTrack > .card.carouselCard{width:180px !important;max-width:180px !important;}
  #handContent .hand.carouselTrack > .card.carouselCard.is-left,
  #handContent .hand.carouselTrack > .card.carouselCard.is-right{width:154px !important;max-width:154px !important;}
  #handContent .handCarousel .carouselMeta{padding-left:160px;}
  #handPanel .handCharacterPriest .rituals{grid-template-columns:1fr;}
