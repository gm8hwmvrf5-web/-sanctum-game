  min-width:34px !important;
  height:48px !important;
  font-size:23px !important;
  border-radius:8px !important;
}
#handContent .hand.carouselTrack{
  grid-template-columns:150px 190px 150px !important;
  width:490px !important;
  max-width:490px !important;
  min-height:292px !important;
  margin:0 !important;
  padding:0 0 22px !important;
  justify-content:start !important;
}
#handContent .hand.carouselTrack > .card.carouselCard{
  width:190px !important;
  max-width:190px !important;
  min-height:277px !important;
  margin:0 !important;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-center{
  min-height:277px !important;
  max-height:277px !important;
  transform:scale(1) !important;
  transform-origin:center center;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-left,
#handContent .hand.carouselTrack > .card.carouselCard.is-right{
  width:170px !important;
  max-width:170px !important;
  min-height:253px !important;
  max-height:253px !important;
  opacity:.68 !important;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-left{
  transform:scale(.82) rotate(-2deg) translateX(24px) !important;
  transform-origin:right center !important;
}
