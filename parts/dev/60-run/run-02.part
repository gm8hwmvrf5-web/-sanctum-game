  min-width:42px;
  padding:0;
  border-radius:10px;
  font-size:27px;
  line-height:1;
  display:grid;
  place-items:center;
  align-self:center;
}
#handContent .handCarousel .carouselNav:disabled{opacity:.28;cursor:default}
#handContent .hand.carouselTrack{
  display:grid !important;
  grid-template-columns:minmax(0,.72fr) minmax(0,1fr) minmax(0,.72fr) !important;
  align-items:center;
  justify-content:center;
  gap:0 !important;
  overflow:visible !important;
  scroll-snap-type:none !important;
  width:100%;
  max-width:680px;
  min-height:286px;
  margin:0 auto !important;
  padding:0 8px 22px !important;
  position:relative;
}
#handContent .hand.carouselTrack > .card.carouselCard{
  display:none !important;
  min-width:0 !important;
  width:100% !important;
  max-width:270px;
  margin:0 auto;
  transition:transform .16s ease,opacity .16s ease,filter .16s ease;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-center{
  display:flex !important;
  grid-column:2;
  grid-row:1;
  z-index:4;
  min-height:272px;
  transform:scale(.94);
  opacity:1;
  filter:none;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-left,
#handContent .hand.carouselTrack > .card.carouselCard.is-right{
  display:flex !important;
  grid-row:1;
  z-index:2;
  min-height:238px;
  max-height:238px;
  opacity:.72;
  filter:saturate(.72) brightness(.78);
  cursor:pointer;
  overflow:hidden;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-left{
  grid-column:1;
  transform:scale(.78) rotate(-2deg) translateX(20px);
  transform-origin:right center;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-right{
  grid-column:3;
  transform:scale(.78) rotate(2deg) translateX(-20px);
  transform-origin:left center;
}
#handContent .hand.carouselTrack > .card.carouselCard.is-left .actions,
#handContent .hand.carouselTrack > .card.carouselCard.is-right .actions,
#handContent .hand.carouselTrack > .card.carouselCard.is-left .cardBottom p,
#handContent .hand.carouselTrack > .card.carouselCard.is-right .cardBottom p,
#handContent .hand.carouselTrack > .card.carouselCard.is-left .empoweredTag,
#handContent .hand.carouselTrack > .card.carouselCard.is-right .empoweredTag{display:none !important}
#handContent .hand.carouselTrack > .card.carouselCard.is-left .cardArt,
#handContent .hand.carouselTrack > .card.carouselCard.is-right .cardArt{height:132px !important}
#handContent .hand.carouselTrack > .card.carouselCard.is-left .cardBottom,
#handContent .hand.carouselTrack > .card.carouselCard.is-right .cardBottom{padding-bottom:6px !important}
#handContent .hand.carouselTrack > .card.carouselCard.is-left h4,
#handContent .hand.carouselTrack > .card.carouselCard.is-right h4{font-size:12px !important;text-align:center;margin:3px 4px !important}
#handContent .handCarousel .carouselMeta{
  grid-column:1/-1;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:8px;
  margin-top:-18px;
  min-height:22px;
  color:#d9c79f;
  font-size:11px;
  letter-spacing:.35px;
}
#handContent .handCarousel .carouselCount{
  border:1px solid #574a35;
  background:#171310;
  border-radius:999px;
  padding:2px 8px;
  white-space:nowrap;
}
#handContent .handCarousel .carouselHint{opacity:.72}
#handContent .handCarousel:focus-visible{outline:1px solid #b99552;outline-offset:4px;border-radius:10px}
@media(max-width:760px){
  #handContent .handCarousel{grid-template-columns:36px minmax(0,1fr) 36px;gap:3px;width:100%}
  #handContent .handCarousel .carouselNav{width:36px;min-width:36px;height:48px;font-size:23px}
  #handContent .hand.carouselTrack{grid-template-columns:minmax(0,.5fr) minmax(180px,1fr) minmax(0,.5fr) !important;min-height:276px;padding-left:0 !important;padding-right:0 !important}
  #handContent .hand.carouselTrack > .card.carouselCard.is-center{min-height:264px;transform:scale(.92)}
  #handContent .hand.carouselTrack > .card.carouselCard.is-left{transform:scale(.65) translateX(38px);}
  #handContent .hand.carouselTrack > .card.carouselCard.is-right{transform:scale(.65) translateX(-38px);}
  #handContent .handCarousel .carouselHint{display:none}
}
@media(max-width:470px){
  #handContent .handCarousel{grid-template-columns:34px minmax(0,1fr) 34px}
  #handContent .hand.carouselTrack{grid-template-columns:34px minmax(190px,1fr) 34px !important;min-height:280px}
  #handContent .hand.carouselTrack > .card.carouselCard.is-left,
  #handContent .hand.carouselTrack > .card.carouselCard.is-right{opacity:.45;max-height:215px}
  #handContent .hand.carouselTrack > .card.carouselCard.is-left{transform:scale(.52) translateX(66px)}
  #handContent .hand.carouselTrack > .card.carouselCard.is-right{transform:scale(.52) translateX(-66px)}
}
</style>
<script id="compactPriestHandCarouselScript">
(()=>{
  'use strict';
  const carouselState=new Map();
  function stateForPlayer(){
    const key=Number.isFinite(S?.current)?S.current:0;
    if(!carouselState.has(key))carouselState.set(key,{index:0,cardId:null});
    return carouselState.get(key);
  }
  function clampIndex(i,n){return n?Math.max(0,Math.min(n-1,i||0)):0}
  function selectIndex(index,rerender=true){
    if(!S?.started||!S.players?.length)return;
    const hand=S.players[S.current]?.hand||[],st=stateForPlayer();
    if(!hand.length){st.index=0;st.cardId=null;return}
    st.index=((index%hand.length)+hand.length)%hand.length;
    st.cardId=hand[st.index]?.id||null;
    if(rerender)renderPlayer();
  }
  function selectedIndex(hand){
    const st=stateForPlayer();
    // Empowering can request a one-time hand focus. Putting that card at the
    // carousel center guarantees it is one of the two full front cards.
    if(S?._focusHandCardId){
      const focusId=S._focusHandCardId;
      const focusIndex=hand.findIndex(c=>c.id===focusId);
      delete S._focusHandCardId;
      if(focusIndex>=0){st.index=focusIndex;st.cardId=focusId;return focusIndex}
    }
    if(st.cardId){
      const found=hand.findIndex(c=>c.id===st.cardId);
      if(found>=0){st.index=found;return found}
    }
    st.index=clampIndex(st.index,hand.length);
    st.cardId=hand[st.index]?.id||null;
    return st.index;
  }
  function enhanceHandCarousel(){
    const handHost=document.getElementById('handContent');
    const handEl=handHost?.querySelector('.hand');
    if(!handEl||!S?.started||!S.players?.length)return;
    const hand=S.players[S.current]?.hand||[];
    const cards=[...handEl.children].filter(el=>el.classList?.contains('card'));
    if(!cards.length)return;
    const idx=selectedIndex(hand),n=cards.length;
    handEl.classList.add('carouselTrack');
    cards.forEach((card,i)=>{
      card.classList.add('carouselCard');
      card.classList.remove('is-left','is-center','is-right');
      card.hidden=true;
      card.removeAttribute('data-carousel-side');
      card.setAttribute('aria-hidden','true');
      card.onclick=null;
      if(i===idx){
        card.hidden=false;card.classList.add('is-center');card.setAttribute('aria-hidden','false');
      }
    });
    if(n>1){
      const left=(idx-1+n)%n,right=(idx+1)%n;
      if(left!==idx){
        const c=cards[left];c.hidden=false;c.classList.add('is-left');c.setAttribute('aria-hidden','false');c.dataset.carouselSide=String(left);c.onclick=e=>{if(e.target.closest('button'))return;selectIndex(left)};
      }
      if(right!==idx&&right!==left){
        const c=cards[right];c.hidden=false;c.classList.add('is-right');c.setAttribute('aria-hidden','false');c.dataset.carouselSide=String(right);c.onclick=e=>{if(e.target.closest('button'))return;selectIndex(right)};
      }else if(n===2){
        const c=cards[left];c.classList.remove('is-left');c.classList.add('is-right');
      }
    }
    const wrap=document.createElement('div');wrap.className='handCarousel';wrap.tabIndex=0;wrap.setAttribute('role','region');wrap.setAttribute('aria-label','Priest hand carousel');
    handEl.parentNode.insertBefore(wrap,handEl);wrap.appendChild(handEl);
    const prev=document.createElement('button');prev.type='button';prev.className='btn carouselNav carouselPrev';prev.setAttribute('aria-label','Previous Priest card');prev.textContent='‹';prev.disabled=n<2;
    const next=document.createElement('button');next.type='button';next.className='btn carouselNav carouselNext';next.setAttribute('aria-label','Next Priest card');next.textContent='›';next.disabled=n<2;
    wrap.insertBefore(prev,handEl);wrap.appendChild(next);
    const meta=document.createElement('div');meta.className='carouselMeta';meta.innerHTML=`<span class="carouselCount"><b>${idx+1}</b> / ${n}</span><span class="carouselHint">Tap a side card or use ← →</span>`;wrap.appendChild(meta);
    prev.onclick=()=>selectIndex(idx-1);next.onclick=()=>selectIndex(idx+1);
    wrap.onkeydown=e=>{
      if(e.target.closest('button,input,select,textarea'))return;
      if(e.key==='ArrowLeft'){e.preventDefault();selectIndex(idx-1)}
      else if(e.key==='ArrowRight'){e.preventDefault();selectIndex(idx+1)}
    };
    let startX=null;
    wrap.onpointerdown=e=>{if(e.target.closest('button'))return;startX=e.clientX};
    wrap.onpointerup=e=>{if(startX===null)return;const dx=e.clientX-startX;startX=null;if(Math.abs(dx)<38)return;selectIndex(idx+(dx<0?1:-1))};
  }
  const baseRenderPlayer=renderPlayer;
  renderPlayer=function(){const out=baseRenderPlayer();enhanceHandCarousel();return out};
  // Apply immediately when loading a saved/in-progress run.
  if(S?.started)renderPlayer();
})();
</script>


<style id="leftHandRightCharacterStyles">
/* Compact horizontal play zone: original-size card carousel left, Priest UI right. */
#handPanel{padding:10px !important;}
#handPanel .handCharacterStage{
  display:grid;
  grid-template-columns:minmax(500px,590px) minmax(0,1fr);
  gap:12px;
