.room.chapel{background-image:linear-gradient(rgba(8,8,10,.10),rgba(8,8,10,.18)),url("data:image/webp;base64,");background-position:center center}
.room.crypt{background-image:linear-gradient(rgba(8,8,10,.10),rgba(8,8,10,.18)),url("data:image/webp;base64,");background-position:center center}
.room.boss{background-image:linear-gradient(rgba(8,8,10,.10),rgba(8,8,10,.18)),url("data:image/webp;base64,");background-position:center center}
.room .demons,.room #bossArea,.room h3,.room .cap{position:relative;z-index:1}
.room:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.18));pointer-events:none;border-radius:inherit}
.demon{background:linear-gradient(180deg,#271717,#1a1011);border-color:#644036;box-shadow:inset 0 0 10px rgba(0,0,0,.32)}.demon.greater{background:linear-gradient(180deg,#311a10,#21120e);border-color:#a9682e}.demon .name{color:#f1d5a4}
.panel{background:linear-gradient(180deg,#171417,#0d0c0f);border-color:#75582e;box-shadow:inset 0 1px 0 rgba(255,231,177,.04),0 5px 16px rgba(0,0,0,.2)}
.panel h2,.panel h3{color:#ecd29a;text-shadow:0 1px 0 #000}.badge{background:#1b1613;border-color:#5e4d35;color:#e6d7bf}.portrait{border-color:#8b6b36;box-shadow:0 4px 12px rgba(0,0,0,.28)}
.ritual{background:linear-gradient(180deg,#251617,#171011);border-color:#754039}.ritual b{color:#f0d2a0}
.card{background:linear-gradient(180deg,#eadbb8,#d1b57d);border-color:#8b6730;box-shadow:inset 0 0 12px rgba(116,88,43,.2),0 5px 12px rgba(0,0,0,.18)}.empoweredCard{background:linear-gradient(180deg,#f2e3ba,#dabc72);box-shadow:inset 0 0 0 2px #d1ab45,0 0 12px rgba(210,174,69,.25)}
.log{background:linear-gradient(#0b0a0a,#070707);border-color:#403629;box-shadow:inset 0 0 16px rgba(0,0,0,.55)}
.modalbox{background:linear-gradient(180deg,#151113,#0b090b);border-color:#8d6a34;box-shadow:0 0 34px rgba(0,0,0,.66),inset 0 1px 0 rgba(255,226,168,.05)}
.choice,.setupPlayer{background:linear-gradient(180deg,#201713,#15100f);border-color:#6c512d}
.notice{background:linear-gradient(180deg,#2d2011,#21170d);border-left-color:#c29748;color:#e1cfad}
.bossCard{background:linear-gradient(180deg,#2a1010,#1a0b0b);border-color:#984038}.bossArt{border-color:#a26d35}
.crucifixCard{background:radial-gradient(circle at 50% 18%,#392818 0,#16100e 40%,#080707 80%);border-color:#96743c}.crucifixName{color:#f2d79d}.crucifixEffect{color:#f0e3cc;border-color:#60482a}
.bottomInfo{background:linear-gradient(180deg,#141113,#0b0a0b)}
.mobileNav{background:#0a090af2;border-top-color:#71542e}.mobileNav button{color:#e4c98e}
/* Compact top menu + tighter hand spacing */
.titlebar{justify-content:flex-start}.menuToggleBtn{flex:0 0 auto;white-space:nowrap}.titlebar.minimized{height:0;min-height:0;padding:0!important;margin:0;border:0!important;background:transparent!important;box-shadow:none!important;backdrop-filter:none!important;overflow:visible;display:block}.titlebar.minimized .toolbar{display:none!important}.titlebar.minimized .menuToggleBtn{position:absolute;right:2px;top:calc(3px + env(safe-area-inset-top));z-index:31;margin:0;min-height:28px;padding:3px 7px;font-size:9px;opacity:.78;pointer-events:auto}.titlebar.minimized .menuToggleBtn:hover{opacity:1}.handPanel{margin-top:7px;padding-top:8px}.handPanel h3{margin-top:0;margin-bottom:6px}.ritualPanel{margin-top:7px}.ritualTracker{padding-top:3px}.toolbar{align-items:center}
@media(max-width:700px){.titlebar{align-items:center}.titlebar .toolbar{justify-content:flex-start}.titlebar.minimized + .stats{top:0}.menuToggleBtn{min-height:36px;font-size:10px;padding:5px 8px}.titlebar.minimized .menuToggleBtn{min-height:28px;font-size:9px;padding:3px 7px}}

.roomMeta{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:-2px 0 6px}.roomMeta .cap{margin:0;text-align:left;line-height:1.25}.roomMeta .tag{display:inline-block;margin-left:4px;padding:1px 5px;border-radius:999px;border:1px solid #6b5734;background:#15110e;color:#ebd39d;font-size:9px;letter-spacing:.5px;text-transform:uppercase}.roomMeta .tag.bad{border-color:#8f3838;color:#ef9b94}.roomMeta .tag.good{border-color:#4e8a59;color:#a9d5a0}.roomMeta .btn{padding:4px 7px;font-size:10px;white-space:nowrap}.roomMeta .btn:disabled{opacity:.55}
</style>


<style id="consecrationPopupCrackStyles">
.room{position:relative;overflow:hidden}
.room .demons,.room #bossArea,.room h3,.room .cap,.room .roomMeta{position:relative;z-index:3}
.room.desecrated{
  border-color:#b92c32 !important;
  box-shadow:inset 0 0 42px rgba(72,0,0,.72),0 0 14px rgba(154,18,24,.36) !important;
}
.room.desecrated::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:2;
  pointer-events:none;
  opacity:.98;
  background-image:url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 420' preserveAspectRatio='none'%3E%3Cg fill='none' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M70 0 L125 58 L101 101 L168 151 L143 198 L219 245 L188 300 L254 356 L233 420 M125 58 L197 83 L231 126 M168 151 L253 137 L294 99 M219 245 L300 220 L345 250 M188 300 L124 330 L87 379 M505 0 L471 66 L505 120 L457 167 L493 214 L436 271 L463 333 L419 380 L433 420 M471 66 L405 88 L373 128 M457 167 L390 150 L350 185 M436 271 L365 289 L326 334 M648 0 L619 50 L655 96 L611 143 L639 195 L591 240 L618 291 L574 343 L590 420 M619 50 L558 72 L530 104 M611 143 L545 126 L510 157 M591 240 L530 261 L490 307' stroke='%23000000' stroke-width='13' opacity='.97'/%3E%3Cpath d='M70 0 L125 58 L101 101 L168 151 L143 198 L219 245 L188 300 L254 356 L233 420 M125 58 L197 83 L231 126 M168 151 L253 137 L294 99 M219 245 L300 220 L345 250 M188 300 L124 330 L87 379 M505 0 L471 66 L505 120 L457 167 L493 214 L436 271 L463 333 L419 380 L433 420 M471 66 L405 88 L373 128 M457 167 L390 150 L350 185 M436 271 L365 289 L326 334 M648 0 L619 50 L655 96 L611 143 L639 195 L591 240 L618 291 L574 343 L590 420 M619 50 L558 72 L530 104 M611 143 L545 126 L510 157 M591 240 L530 261 L490 307' stroke='%23b51d26' stroke-width='3.5' opacity='.92'/%3E%3C/g%3E%3C/svg%3E");
  background-size:100% 100%;
  background-repeat:no-repeat;
  background-blend-mode:multiply;
  border-top:1px solid rgba(111,78,30,.34);
}
.room.desecrated::after{
  content:"";
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  border-radius:inherit;
  background:radial-gradient(circle at center,rgba(0,0,0,.14),rgba(94,0,0,.24) 72%,rgba(0,0,0,.5));
}
.room.consecrated{
  border-color:#9b8244 !important;
  box-shadow:inset 0 0 34px rgba(190,156,59,.18),0 0 12px rgba(172,143,59,.22) !important;
}
.consecrateBox{width:min(480px,94vw)}
.consecrateSummary{border:1px solid #6f5732;background:#17110f;border-radius:10px;padding:12px;margin:10px 0}
.consecrateRoomName{font-size:24px;color:#f0d6a0;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.consecrateCost{font-size:15px;color:#e7c67f;margin:6px 0}
.consecrateEffect{font-size:13px;line-height:1.45;color:#ded2bd;margin-top:8px}
.consecrateStatus{font-size:12px;line-height:1.4;margin-top:10px;padding:8px;border-radius:7px;background:#0d0c0c;border:1px solid #4b3d2a;color:#bfb29c}
.consecrateStatus.bad{border-color:#7a3434;color:#ef9b94}
.consecrateStatus.good{border-color:#4e7757;color:#a9d5a0}
.consecrateActions{display:flex;gap:8px;margin-top:12px}
.consecrateActions .btn{flex:1;min-height:44px}
</style>


<style id="desecrationInfoStyles">
.desecrationEffectText{
  margin-top:4px;
  padding:4px 6px;
  border-left:3px solid #9f252c;
  background:rgba(35,5,7,.7);
  color:#efb0aa;
  font-size:9.5px;
  line-height:1.3;
  border-radius:4px;
}
.desecrationInfoBtn{
  appearance:none;
  border:1px solid #8f3838;
  background:#241011;
  color:#ef9b94;
  border-radius:999px;
  padding:2px 7px;
  font-size:9px;
  line-height:1.2;
  text-transform:uppercase;
  letter-spacing:.5px;
  cursor:pointer;
  margin-left:4px;
}
.desecrationInfoBtn:focus{outline:2px solid #d7867e;outline-offset:2px}
.desecrationBox{width:min(480px,94vw)}
.desecrationRoomName{
  font-size:24px;
  color:#ef9b94;
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:8px
}
.desecrationEffect{
  border:1px solid #733338;
  background:#1a0d0f;
  border-radius:10px;
  padding:12px;
  color:#ead2cf;
  font-size:14px;
  line-height:1.5
}
.desecrationClose{width:100%;min-height:44px;margin-top:12px}
</style>


<style id="softerCrackOverrides">
.room.desecrated{border-width:1px !important;box-shadow:inset 0 0 22px rgba(0,0,0,.42),0 0 8px rgba(0,0,0,.12) !important}
.room.desecrated::before{opacity:.46 !important;background-size:100% 100% !important;background-repeat:no-repeat !important}
.room.desecrated::after{background:radial-gradient(circle at center,rgba(0,0,0,.10),rgba(0,0,0,.04) 64%,rgba(0,0,0,.14)) !important}
.room.gateway.desecrated::before{background-image:url("data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20800%20420%22%20preserveAspectRatio%3D%22none%22%3E%0A%20%20%20%20%3Cg%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M95%200%20L142%2054%20L118%2098%20L176%20146%20L154%20193%20L212%20245%20L184%20294%20L235%20350%20L214%20420%20M142%2054%20L198%2083%20L226%20118%20M176%20146%20L239%20136%20L278%20102%20M212%20245%20L286%20225%20L324%20253%20M184%20294%20L127%20326%20L94%20371%20M505%200%20L480%2045%20L514%2093%20L472%20141%20L503%20191%20L455%20244%20L486%20301%20L444%20361%20L456%20420%20M480%2045%20L424%2068%20L394%20108%20M472%20141%20L410%20143%20L360%20176%20M455%20244%20L388%20270%20L348%20314%20M650%200%20L624%2039%20L658%2078%20L617%20121%20L636%20165%20L592%20211%20L610%20261%20L571%20311%20L584%20420%20M624%2039%20L571%2056%20L542%2092%20M617%20121%20L675%20132%20L710%20163%20M592%20211%20L536%20226%20L502%20260%20M571%20311%20L632%20344%20L669%20386%22%20stroke%3D%22%23e199a0%22%20stroke-width%3D%223%22%20opacity%3D%220.24%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M95%200%20L142%2054%20L118%2098%20L176%20146%20L154%20193%20L212%20245%20L184%20294%20L235%20350%20L214%20420%20M142%2054%20L198%2083%20L226%20118%20M176%20146%20L239%20136%20L278%20102%20M212%20245%20L286%20225%20L324%20253%20M184%20294%20L127%20326%20L94%20371%20M505%200%20L480%2045%20L514%2093%20L472%20141%20L503%20191%20L455%20244%20L486%20301%20L444%20361%20L456%20420%20M480%2045%20L424%2068%20L394%20108%20M472%20141%20L410%20143%20L360%20176%20M455%20244%20L388%20270%20L348%20314%20M650%200%20L624%2039%20L658%2078%20L617%20121%20L636%20165%20L592%20211%20L610%20261%20L571%20311%20L584%20420%20M624%2039%20L571%2056%20L542%2092%20M617%20121%20L675%20132%20L710%20163%20M592%20211%20L536%20226%20L502%20260%20M571%20311%20L632%20344%20L669%20386%22%20stroke%3D%22%237a252d%22%20stroke-width%3D%220.9%22%20opacity%3D%220.62%22%2F%3E%0A%20%20%20%20%3C%2Fg%3E%3C%2Fsvg%3E") !important}