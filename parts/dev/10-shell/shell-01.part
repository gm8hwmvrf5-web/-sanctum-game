<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>Sanctum of the Damned — Roguelite Edition</title>
<meta name="theme-color" content="#160b0b" />
<meta name="description" content="Single-file roguelite edition of Sanctum of the Damned, preserving the original board, cards, artwork, and combat systems." />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Sanctum" />
<link rel="apple-touch-icon" sizes="180x180" href="./icons/icon-180.png" />
<link rel="manifest" href="./manifest.webmanifest" />
<style>
:root{--bg:#09090b;--panel:#131217;--panel2:#1b1717;--gold:#d4aa55;--parch:#ead9b0;--red:#8d1515;--blood:#b51f29;--blue:#1c5ca8;--green:#38724f;--muted:#a89f92;--line:#66502b;--ok:#7cb87b;--bad:#d56d63}
*{box-sizing:border-box}html,body{margin:0;background:radial-gradient(circle at top,#131010 0%,#0a0909 58%,#050505 100%);color:var(--ink);font-family:Georgia,"Times New Roman",serif;position:relative;overflow-x:hidden}button,select,input{font:inherit}.hidden{display:none!important}
body:before{content:"";position:fixed;inset:0;background-color:#0d0b0b;background-image:url("data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22240%22%20height%3D%22128%22%20viewBox%3D%220%200%20240%20128%22%3E%0A%3Crect%20width%3D%22240%22%20height%3D%22128%22%20fill%3D%22%23171312%22%2F%3E%0A%3Cg%20fill%3D%22%2327211f%22%20stroke%3D%22%230c0a0a%22%20stroke-width%3D%224%22%3E%0A%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%22120%22%20height%3D%2264%22%2F%3E%3Crect%20x%3D%22120%22%20y%3D%220%22%20width%3D%22120%22%20height%3D%2264%22%2F%3E%0A%3Crect%20x%3D%22-60%22%20y%3D%2264%22%20width%3D%22120%22%20height%3D%2264%22%2F%3E%3Crect%20x%3D%2260%22%20y%3D%2264%22%20width%3D%22120%22%20height%3D%2264%22%2F%3E%3Crect%20x%3D%22180%22%20y%3D%2264%22%20width%3D%22120%22%20height%3D%2264%22%2F%3E%0A%3C%2Fg%3E%0A%3Cg%20fill%3D%22none%22%20stroke%3D%22%23342b28%22%20stroke-width%3D%222%22%20opacity%3D%22.42%22%3E%0A%3Cpath%20d%3D%22M5%208H115M125%208H235M5%2072H55M65%2072H175M185%2072H235%22%2F%3E%0A%3C%2Fg%3E%0A%3Crect%20width%3D%22240%22%20height%3D%22128%22%20fill%3D%22%23000%22%20opacity%3D%22.38%22%2F%3E%0A%3C%2Fsvg%3E");background-position:center top;background-size:240px 128px;background-repeat:repeat;opacity:.72;pointer-events:none}
.app{position:relative;max-width:1450px;margin:auto;padding:12px}.titlebar{display:flex;gap:14px;align-items:center;justify-content:space-between;border:1px solid var(--line);background:linear-gradient(#1a1715,#0d0c0c);padding:10px 14px;box-shadow:0 0 0 2px #050505,0 0 22px #000}.brand{font-size:clamp(22px,4vw,38px);letter-spacing:2px;color:#f0d6a0;text-transform:uppercase}.subtitle{color:#a7906a;font-size:12px;letter-spacing:2px}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.btn{background:linear-gradient(#30251a,#17120e);border:1px solid #9a793e;color:#f4e0b5;padding:8px 11px;border-radius:7px;cursor:pointer}.btn:hover{filter:brightness(1.15)}.btn.red{background:linear-gradient(#7d1d1d,#3e0d0d);border-color:#c5574d}.btn.blue{background:linear-gradient(#1d4678,#10233b)}.btn.green{background:linear-gradient(#305d3e,#152c1e)}.btn:disabled{opacity:.45;cursor:not-allowed}
.stats{display:grid;grid-template-columns:repeat(5,minmax(105px,1fr));gap:8px;margin:10px 0}.stat{border:1px solid var(--line);background:#121010d9;padding:8px;text-align:center;border-radius:8px}.stat b{display:block;color:#e9c77e;font-size:21px}.stat span{font-size:11px;color:#a99b84;text-transform:uppercase;letter-spacing:1px}
.board{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.room{min-height:170px;border:1px solid #75572a;border-radius:10px;padding:8px;background:linear-gradient(180deg,#1c1515e8,#0e0d0de8);box-shadow:inset 0 0 22px #000}.room.gateway{box-shadow:inset 0 0 24px #5d1010}.room.chapel{box-shadow:inset 0 0 24px #0d3768}.room.crypt{box-shadow:inset 0 0 24px #164a37}.room.boss{box-shadow:inset 0 0 24px #721414}.room h3{margin:0 0 7px;text-align:center;color:#ebd198;letter-spacing:1px;font-size:16px}.room .cap{font-size:10px;color:#8c7d6a;text-align:center;margin-bottom:5px}.demons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.demon{border:1px solid #573838;background:#201212;padding:6px;border-radius:7px;font-size:11px;cursor:pointer;position:relative}.demon.greater{border-color:#b46b2d;background:#2a1710}.demon.selected{outline:2px solid #e4c46f}.demon .name{font-weight:bold;color:#f1d5a4}.demon .hp{color:#ff8585}.demon .blood{color:#df3f48}.statusdot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#d59d33;margin-left:3px}.bossCard{border:1px solid #9e3a30;background:#270d0d;padding:9px;border-radius:8px}.bossCard.hiddenboss{filter:blur(3px);opacity:.5}
.main{display:grid;grid-template-columns:1.6fr 1fr;gap:10px;margin-top:10px}.panel{border:1px solid var(--line);background:#111013e8;border-radius:10px;padding:10px}.panel h2,.panel h3{margin:0 0 8px;color:#ead099}.playerHeader{display:grid;grid-template-columns:110px 1fr;gap:10px;align-items:start}.portrait{width:110px;height:85px;object-fit:cover;object-position:left top;border:1px solid #826739;border-radius:8px}.playerMeta{display:flex;gap:8px;flex-wrap:wrap}.badge{border:1px solid #574a35;background:#1b1713;padding:4px 7px;border-radius:999px;font-size:12px}.hand{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:7px;margin-top:8px}.card{background:linear-gradient(#e8d8b2,#c9ad79);color:#24170d;border:2px solid #8a6630;border-radius:9px;padding:8px;min-height:128px;position:relative;box-shadow:inset 0 0 12px #74582b55}.card .cost{position:absolute;right:7px;top:6px;background:#14365d;color:white;border-radius:50%;width:29px;height:29px;display:grid;place-items:center;font-weight:bold}.card h4{margin:0 34px 5px 0;font-size:14px}.card p{font-size:11px;line-height:1.25;margin:4px 0}.card .actions{display:flex;gap:5px;position:absolute;bottom:7px;left:7px;right:7px}.card .actions button{flex:1;font-size:10px;padding:4px}.empowerable{box-shadow:0 0 0 2px #8c1010 inset,0 0 10px #8c101055}.empoweredCard{box-shadow:0 0 0 2px #d8b24b inset,0 0 14px #d8b24b88;background:linear-gradient(#f4e3b8,#d8bb72)}.empoweredCard .cost{width:auto;height:auto;min-width:44px;padding:5px 8px;border-radius:999px;background:#6d4c12;color:#fff2b8;font-size:9px}.empoweredTag{display:inline-block;margin:0 0 4px;padding:2px 6px;border-radius:999px;background:#6d4c12;color:#fff2b8;font-size:10px;font-weight:bold;letter-spacing:.5px}.rituals{display:grid;gap:6px;margin-top:6px}.ritual{border:1px solid #6f3b36;background:#211313;padding:6px;border-radius:7px;font-size:10.5px;line-height:1.22}.ritual b{color:#efd1a0}.ritual small{display:block;color:#b4a48d;margin-top:2px;font-size:9.5px;line-height:1.24}.ritual.used{opacity:.45}.turnActions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.log{height:300px;overflow:auto;background:#090909;border:1px solid #3d3529;border-radius:7px;padding:7px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px}.log div{padding:3px 0;border-bottom:1px dotted #28231d}.log .good{color:#9aca91}.log .bad{color:#ef8b82}.log .info{color:#c9b277}.controls{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-top:8px}.controls button{font-size:11px}
.modal{position:fixed;inset:0;background:#000b;display:grid;place-items:center;z-index:50;padding:15px}.modalbox{width:min(880px,96vw);max-height:90vh;overflow:auto;background:#100e0f;border:2px solid #8b6b33;border-radius:12px;padding:15px;box-shadow:0 0 35px #000}.crucifixBox{width:min(520px,94vw);padding:12px;background:#080707;border-color:#b58a45}.crucifixCard{position:relative;overflow:hidden;border:2px solid #8b6b33;border-radius:14px;background:radial-gradient(circle at 50% 18%,#3b2a18 0,#17110d 38%,#080707 78%);padding:22px 18px 18px;text-align:center;box-shadow:inset 0 0 35px #000,0 0 28px #000}.crucifixCard:before{content:"✞";display:block;font-size:54px;line-height:1;color:#d2ab63;text-shadow:0 0 16px #9d6b2c;margin-bottom:6px}.crucifixCard.good{border-color:#5f936a}.crucifixCard.good:before{color:#9fc88f}.crucifixCard.bad{border-color:#98443d}.crucifixCard.bad:before{color:#d07167}.crucifixCard.double{border-color:#9b7842}.crucifixType{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#a99573;margin-bottom:4px}.crucifixName{font-size:clamp(24px,6vw,34px);color:#f0d6a0;text-transform:uppercase;letter-spacing:1px;margin:4px 0 12px}.crucifixEffect{font-size:16px;line-height:1.5;color:#eee0c8;border-top:1px solid #5c472b;border-bottom:1px solid #5c472b;padding:14px 4px;margin:0 auto 12px}.crucifixResult{font-size:12px;line-height:1.4;color:#c8b99d;min-height:18px}.crucifixClose{width:100%;margin-top:12px;font-size:15px;min-height:46px}.setupOptionsRow{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:8px 0 10px}.setupOptionsRow label{display:flex;align-items:center;gap:7px;color:#d8c6a5;font-size:12px}.setupOptionsRow select{background:#0e0d0d;color:#f1dfbc;border:1px solid #80643a;border-radius:6px;padding:6px 8px}.setupgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.setupPlayer{border:1px solid #5e4b2c;padding:10px;border-radius:8px}.choicegrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px}.choice{border:1px solid #664b28;background:#1b1511;padding:8px;border-radius:8px;cursor:pointer}.choice:hover{background:#2a2017}.notice{background:#2a1e10;border-left:4px solid #c49745;padding:8px;margin:8px 0;color:#dcc9a6;font-size:12px}.footer{font-size:11px;color:#897c6c;text-align:center;padding:10px}.danger{color:#ff8175}.ok{color:#9ed19b}
.bottomInfo{margin-top:10px}.bottomInfo h3{margin:0 0 4px;color:#f0d6a0}.bottomInfo .bottomSubtitle{color:#a7906a;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px}.bottomInfo .footer{padding:6px 0 0}

.handPanel{margin-top:12px}.handPanel h3{margin:0 0 8px;color:#ead099;letter-spacing:.7px;text-transform:uppercase}.handPanel .notice{margin:6px 0}.handPanel .hand{margin-top:8px}.ritualPanel{margin-top:10px}.ritualStage{display:grid;grid-template-columns:minmax(220px,30%) minmax(0,70%);gap:10px;align-items:stretch}.playerMini{border-right:1px solid #4f402c;padding-right:10px;min-width:0}.playerMini h2{margin:0 0 8px;color:#ead099;letter-spacing:.7px;text-transform:uppercase}.ritualMain{min-width:0}.ritualPanel h3{margin:6px 0;color:#ead099;letter-spacing:.7px;text-transform:uppercase}.ritualTracker{display:flex;gap:6px;flex-wrap:wrap;padding:2px 0 4px;border-bottom:1px solid #4f402c;margin-bottom:6px}.ritualTracker .badge{font-size:11px;padding:3px 6px}.logOnly{grid-template-columns:1fr}.logOnly #logPanel{width:100%}
@media(min-width:1100px){
 .app{max-width:1800px;padding:16px 20px 30px}
 .titlebar{border-radius:0 0 10px 10px}
 .stats{grid-template-columns:repeat(5,minmax(0,1fr))}
 .room{min-height:245px;padding:10px}
 .main{grid-template-columns:minmax(0,2fr) minmax(340px,.72fr);gap:14px}
 .panel{padding:14px}
 .playerHeader{grid-template-columns:130px 1fr}.portrait{width:130px;height:100px}
 .rituals{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
 .ritual{min-height:130px;display:flex;flex-direction:column;padding:6px;font-size:11px;line-height:1.23}.ritual small{font-size:9.8px;line-height:1.23;margin-top:3px}.ritual .btn{margin-top:auto;padding:5px 7px;min-height:32px;font-size:9.5px}
 .hand{grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}
 .card{min-height:150px;padding:10px}.card p{font-size:12px}
 .log{height:390px}
 .controls{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(min-width:1450px){.demons{grid-template-columns:repeat(2,minmax(0,1fr))}.demon{min-height:118px}.abilityText{font-size:10px}}
@media(max-width:900px){.stats{grid-template-columns:repeat(3,1fr)}.board{grid-template-columns:1fr 1fr}.room.boss{grid-column:1/-1}.main{grid-template-columns:1fr}.setupgrid{grid-template-columns:1fr}}
@media(max-width:520px){.app{padding:6px}.stats{grid-template-columns:repeat(2,1fr)}.board{grid-template-columns:1fr}.room.boss{grid-column:auto}.playerHeader{grid-template-columns:86px 1fr}.portrait{width:86px;height:75px}.hand{grid-template-columns:1fr 1fr}.brand{font-size:22px}.toolbar .btn{font-size:11px;padding:6px}}

/* Browser shell + responsive mobile support */
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{overscroll-behavior-y:none;touch-action:manipulation}
button,.btn,select,input{min-height:36px;-webkit-tap-highlight-color:transparent}
.titlebar{position:sticky;top:0;z-index:25;padding-top:calc(10px + env(safe-area-inset-top));backdrop-filter:blur(12px)}
.installHint{margin:8px 0;padding:10px 12px;border:1px solid #9a793e;border-radius:9px;background:#25190c;color:#f1d3a0;font-size:13px}
.mobileNav{display:none}
@media(max-width:700px){
 body{padding-bottom:max(0px,env(safe-area-inset-bottom))}
 button,.btn,select,input{min-height:44px}
 .app{padding:6px 6px 10px}.titlebar{gap:8px;align-items:flex-start}.subtitle{font-size:9px}.toolbar{justify-content:flex-end}.toolbar .btn{font-size:10px;padding:5px 7px;min-height:36px}.notice{font-size:11px}
 .stats{position:sticky;top:82px;z-index:20;grid-template-columns:repeat(3,1fr);gap:4px;background:#09090bea;padding:4px 0;margin:6px 0;backdrop-filter:blur(10px)}
 .stat{padding:5px 2px}.stat b{font-size:17px}.stat span{font-size:8px}
 .board{display:flex;grid-template-columns:none;overflow-x:auto;gap:8px;scroll-snap-type:x mandatory;padding:2px 4px 10px;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
 .room{flex:0 0 84vw;min-height:220px;scroll-snap-align:center}.room.boss{grid-column:auto}
 .main{display:block;margin-top:4px}.panel{margin-bottom:8px;padding:8px}
 .playerHeader{grid-template-columns:78px 1fr}.portrait{width:78px;height:78px}.playerMeta{gap:4px}.badge{font-size:10px;padding:3px 5px}
 .turnActions{position:sticky;bottom:70px;z-index:18;background:#111013f2;padding:7px 4px;border-top:1px solid #5c4729;border-bottom:1px solid #5c4729}.turnActions .btn{flex:1}
 .ritual{font-size:12px;padding:8px}.ritual .btn{width:100%;margin-top:6px}
 .hand{display:flex;grid-template-columns:none;overflow-x:auto;gap:8px;scroll-snap-type:x mandatory;padding-bottom:8px;-webkit-overflow-scrolling:touch}.card{flex:0 0 82vw;min-height:158px;scroll-snap-align:center}.card p{font-size:12px}.card .actions button{min-height:38px}
 .log{height:220px}.controls{grid-template-columns:repeat(2,1fr)}
 .modal{align-items:end;padding:0}.modalbox{width:100vw;max-height:88dvh;border-radius:16px 16px 0 0;padding:14px 12px calc(14px + env(safe-area-inset-bottom));border-left:0;border-right:0;border-bottom:0}.setupgrid{grid-template-columns:1fr}.choicegrid{grid-template-columns:1fr}.choice{min-height:54px}
 .mobileNav{display:none!important;visibility:hidden!important;pointer-events:none!important}
 .mobileNav button{border:0;background:transparent;color:#e3c98f;min-height:52px;font-size:18px}.mobileNav button span{display:block;font-size:9px;letter-spacing:1px;text-transform:uppercase;margin-top:2px}
 .footer{padding-bottom:8px}
}
@media(max-width:390px){.brand{font-size:19px}.stats{top:78px}.room{flex-basis:88vw}.card{flex-basis:86vw}}
@media(display-mode:standalone){.installHint{display:none!important}.titlebar{padding-top:calc(8px + env(safe-area-inset-top))}}


.bossCard{padding:7px}.bossArt{width:100%;aspect-ratio:1.25/1;object-fit:cover;object-position:top;border-radius:7px;border:1px solid #a86c36;display:block;margin-bottom:6px;box-shadow:0 0 14px #000}.bossName{font-size:14px;color:#f3d39a;font-weight:bold;line-height:1.1}.bossSubtitle{font-size:9px;color:#b79c70;text-transform:uppercase;letter-spacing:.8px;margin:2px 0 5px}.bossAbilityMini{font-size:9px;line-height:1.25;color:#d9c8ae;margin-top:5px}.bossAbilityMini b{color:#e6a67a}.bossDeckGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}.bossDeckCard{border:1px solid #6e4b29;background:#120d0d;border-radius:9px;padding:7px}.bossDeckCard img{width:100%;height:auto;display:block;border-radius:6px;border:1px solid #95632f}.bossDeckCard .bossDeckMeta{padding:6px 2px 2px;color:#d8c19a;font-size:11px}.bossDeckBox{width:min(1250px,98vw)}@media(max-width:700px){.bossDeckGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.bossArt{aspect-ratio:1.05/1}}@media(max-width:420px){.bossDeckGrid{grid-template-columns:1fr}}

/* Rituals + log layout */
.ritualLogStage{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(300px,.72fr);gap:10px;align-items:start;margin-top:7px}.ritualPanel{margin-top:0;min-width:0}.ritualMain{min-width:0}.ritualTracker{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:2px 0 7px;border-bottom:1px solid #4f402c;margin-bottom:7px}.ritualTracker .badge{font-size:11px;padding:4px 7px}.ritualTracker .trackerAction{padding:5px 9px;font-size:10px;min-height:29px}.playerTurnTag{margin-left:auto;display:flex;align-items:center;gap:7px;padding:4px 8px;border-left:1px solid #5b472f;color:#ead099;white-space:nowrap}.playerTurnTag b{font-size:12px;color:#f0d5a0}.playerTurnTag small{font-size:10px;color:#b9aa92}.ritualMain h3{margin:6px 0;color:#ead099;letter-spacing:.7px;text-transform:uppercase}.ritualMain .rituals{width:100%;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.ritualMain .ritual{min-height:130px;display:flex;flex-direction:column;padding:6px;font-size:11px;line-height:1.23}.ritualMain .ritual small{font-size:9.8px;line-height:1.23;margin-top:3px}.ritualMain .ritual .btn{margin-top:auto;padding:5px 7px;min-height:32px;font-size:9.5px}.ritualLogStage #logPanel{margin:0;min-width:0}.ritualLogStage #logPanel>h3:first-child{margin:0 0 5px}.ritualLogStage #logPanel>h3:nth-of-type(2){margin:5px 0 5px!important}.ritualLogStage .log{height:104px;line-height:1.25}.ritualLogStage .log div{padding:2px 0}.ritualLogStage .controls{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:3px}
@media(max-width:1000px){.ritualLogStage{grid-template-columns:minmax(0,1.55fr) minmax(280px,.85fr)}.playerTurnTag{width:100%;margin-left:0;border-left:0;border-top:1px solid #4f402c;padding-left:0}.ritualMain .ritual{min-height:124px}}
@media(max-width:800px){.ritualLogStage{grid-template-columns:1fr}.ritualMain .rituals{grid-template-columns:repeat(3,minmax(0,1fr))}.ritualLogStage .log{height:104px}}
@media(max-width:700px){.ritualMain .rituals{grid-template-columns:1fr}.ritualMain .ritual{min-height:0!important;font-size:12px;padding:8px}.ritualMain .ritual small{font-size:10px}.ritualTracker{gap:5px}.ritualTracker .trackerAction{flex:1}.playerTurnTag{order:-1;width:100%;border-top:0;border-bottom:1px solid #4f402c;padding:3px 0 6px;margin-bottom:2px}}

.room{background-image:none !important;background-color:#141112 !important;background-size:auto !important;background-position:center center !important;border-width:2px !important;box-shadow:inset 0 0 0 1px rgba(255,232,180,.06), inset 0 0 28px rgba(0,0,0,.55), 0 0 14px rgba(0,0,0,.18) !important}
.room:after{background:none !important}
.room.gateway{background:radial-gradient(ellipse at center,#080809 0%,#0b090a 32%,#351014 76%,#5b1d24 100%) !important;border-color:#8b2e33 !important;box-shadow:inset 0 0 30px rgba(0,0,0,.52),0 0 10px rgba(86,20,24,.18) !important}
.room.hall{background:radial-gradient(ellipse at center,#08090c 0%,#0a0d14 32%,#14274d 76%,#3159a6 100%) !important;border-color:#3d68bf !important;box-shadow:inset 0 0 30px rgba(0,0,0,.54),0 0 10px rgba(24,51,111,.18) !important}
.room.chapel{background:radial-gradient(ellipse at center,#090908 0%,#11100b 32%,#51431a 76%,#9a8130 100%) !important;border-color:#d2b44b !important;box-shadow:inset 0 0 30px rgba(0,0,0,.54),0 0 10px rgba(127,101,22,.16) !important}
.room.crypt{background:radial-gradient(ellipse at center,#080809 0%,#101013 32%,#36363d 76%,#777780 100%) !important;border-color:#9a9aa3 !important;box-shadow:inset 0 0 30px rgba(0,0,0,.56),0 0 10px rgba(70,70,78,.16) !important}
.room.boss{background:radial-gradient(ellipse at center,#090607 0%,#120709 32%,#500b12 76%,#991722 100%) !important;border-color:#cc2832 !important;box-shadow:inset 0 0 32px rgba(0,0,0,.58),0 0 12px rgba(113,8,14,.20) !important}
.room.gateway h3{color:#f2c0c2 !important}.room.hall h3{color:#cadbff !important}.room.chapel h3{color:#f5e4a2 !important}.room.crypt h3{color:#e0e0e5 !important}.room.boss h3{color:#ffc0c3 !important}
.room.gateway .cap{color:#d3a0a3 !important}.room.hall .cap{color:#9fb7ea !important}.room.chapel .cap{color:#d9ca8a !important}.room.crypt .cap{color:#b7b7bf !important}.room.boss .cap{color:#d8a0a4 !important}


.roomMeta{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:-2px 0 6px}.roomMeta .cap{margin:0;text-align:left;line-height:1.25}.roomMeta .tag{display:inline-block;margin-left:4px;padding:1px 5px;border-radius:999px;border:1px solid #6b5734;background:#15110e;color:#ebd39d;font-size:9px;letter-spacing:.5px;text-transform:uppercase}.roomMeta .tag.bad{border-color:#8f3838;color:#ef9b94}.roomMeta .tag.good{border-color:#4e8a59;color:#a9d5a0}.roomMeta .btn{padding:4px 7px;font-size:10px;white-space:nowrap}.roomMeta .btn:disabled{opacity:.55}

/* Priest card art vertical shift */
.hand .card .cardArt{background-position:center center !important;}
.hand .card .cardArt.divineWrathArt{background-position:center center !important;}

/* tighten priest hand header spacing */
.handPanel{margin-top:4px !important;}
.handPanel .relicSummary{margin:0 0 4px !important;}
.handPanel .notice{margin:2px 0 4px !important;}
.handPanel h3{margin:2px 0 3px !important; padding-top:0 !important;}
.handPanel .hand{margin-top:2px !important;}


/* make priest cards about 5% less wide on desktop */
.handPanel .hand{grid-template-columns:repeat(auto-fill,minmax(180px,1fr)) !important;}


/* lower priest card art and text slightly */
.hand .card .cardArt{margin:6px -8px 0 !important; background-position:center 54% !important;}
.hand .card .cardBottom{padding-top:6px !important;}
.hand .card h4{margin-top:2px !important;}
.hand .card .cardBottom p:first-of-type{margin-top:5px !important;}


/* enlarge priest art crop so it fills to the top of the card */
.hand .card .cardArt{height:112px !important; margin:-8px -8px 0 !important; background-size:cover !important; background-position:center 54% !important;}

</style>

<style id="demonAbilityStyles">
.demon{display:flex;flex-direction:column;gap:6px;align-items:stretch;min-height:0;padding:5px}.demonArtWrap{width:100%;height:92px;overflow:hidden;border:1px solid #8b6737;border-radius:6px;flex:none;background:#120d0d;box-shadow:inset 0 0 14px rgba(0,0,0,.45)}.demonArt{display:block;width:100%;height:170%;object-fit:cover;object-position:center 28%;margin-top:-6%;filter:saturate(1.02) contrast(1.03)}.demonBody{min-width:0;flex:1;display:flex;flex-direction:column;gap:4px}.demon .name{color:#f1d5a4;font-weight:bold;line-height:1.1;font-size:11px}.demonStats{display:flex;flex-wrap:wrap;gap:3px 4px;font-size:9.5px;line-height:1.2}.demonStats span{display:inline-block;padding:1px 4px;border:1px solid #5e4a35;border-radius:999px;background:rgba(0,0,0,.18)}.demon .attack{color:#e4c17a}.familyTag{display:inline-block;align-self:flex-start;margin:0;padding:1px 5px;border:1px solid #614d33;border-radius:999px;color:#cdb783;font-size:8px;letter-spacing:.6px;text-transform:uppercase}.abilityText{font-size:10px;line-height:1.32;color:#e5d9c7;margin-top:1px;white-space:normal;word-break:normal;overflow-wrap:anywhere}.manualAbility{font-size:8.5px;line-height:1.25;color:#d7a062;margin-top:2px}.deckgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.deckpair{border:1px solid #6f542f;border-radius:9px;background:#151111;padding:7px;display:grid;grid-template-columns:1fr auto 1fr;gap:6px;align-items:stretch}.deckface{background:#1b1513;border:1px solid #4e3b2c;border-radius:7px;padding:6px;display:flex;flex-direction:column}.deckface.greater{background:#241510;border-color:#8b5e31}.deckface img{width:100%;aspect-ratio:1.05/1;object-fit:cover;object-position:top;border-radius:5px;border:1px solid #74552d;margin-bottom:5px}.deckface b{color:#ecd09a}.deckface small{color:#a9987d;font-size:9px}.deckface p{font-size:10px;line-height:1.28;color:#ddd0ba;margin:5px 0 0}.deckarrow{align-self:center;color:#d4aa55;font-size:20px}.demonDeckBox{width:min(1100px,98vw)}
@media(max-width:700px){.demons{grid-template-columns:1fr}.demon{min-height:0}.demonArtWrap{height:112px}.demonArt{height:175%;object-position:center 28%;margin-top:-8%}.abilityText{font-size:11px}.demonStats{font-size:11px}.deckgrid{grid-template-columns:1fr}.deckpair{grid-template-columns:1fr auto 1fr}.deckface p{font-size:10.5px}}
@media(max-width:390px){.deckpair{grid-template-columns:1fr}.deckarrow{text-align:center;transform:rotate(90deg)}}

.roomMeta{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:-2px 0 6px}.roomMeta .cap{margin:0;text-align:left;line-height:1.25}.roomMeta .tag{display:inline-block;margin-left:4px;padding:1px 5px;border-radius:999px;border:1px solid #6b5734;background:#15110e;color:#ebd39d;font-size:9px;letter-spacing:.5px;text-transform:uppercase}.roomMeta .tag.bad{border-color:#8f3838;color:#ef9b94}.roomMeta .tag.good{border-color:#4e8a59;color:#a9d5a0}.roomMeta .btn{padding:4px 7px;font-size:10px;white-space:nowrap}.roomMeta .btn:disabled{opacity:.55}
</style>
<meta name="sanctum-build" content="standalone-single-file" />
<style id="safeThemePolish">
/* Visual-only theme layer. No gameplay, layout, positioning, or interaction rules are changed. */
:root{--line:#76582d;--gold:#e0bb69;--ink:#eee3cf}
body{background:radial-gradient(circle at 50% 0,#291817 0,#130d0f 26%,#09090b 64%,#060607 100%);color:#eee3cf;font-family:Georgia,"Times New Roman",serif}
.titlebar{background:linear-gradient(180deg,#241a16,#0e0d0e);border-color:#8f6d35;box-shadow:inset 0 1px 0 rgba(255,227,166,.08),0 4px 16px rgba(0,0,0,.38)}
.toolbar .btn,.btn{background:linear-gradient(180deg,#3b2c1d,#18120e);border-color:#aa8241;color:#f7e6bd;box-shadow:inset 0 1px 0 rgba(255,235,184,.08),0 3px 8px rgba(0,0,0,.24)}
.btn.red{background:linear-gradient(#762423,#3b0f10);border-color:#b95c55}.btn.blue{background:linear-gradient(#264f7d,#102238);border-color:#5e83ab}.btn.green{background:linear-gradient(#386349,#172c20);border-color:#6b9275}
.stats .stat{background:linear-gradient(180deg,#1c1818,#0e0d0e);border-color:#775c33;box-shadow:inset 0 0 14px rgba(0,0,0,.34)}
.stat b{color:#edc875;text-shadow:0 0 10px rgba(196,137,48,.18)}.stat span{color:#b3a287}
.room{background:linear-gradient(180deg,#1c1516,#0d0c0e);border-color:#76562c;box-shadow:inset 0 0 22px rgba(0,0,0,.6)}
.room.gateway{box-shadow:inset 0 0 24px rgba(105,20,23,.45)}.room.chapel{box-shadow:inset 0 0 24px rgba(21,57,94,.42)}.room.crypt{box-shadow:inset 0 0 24px rgba(25,77,55,.4)}.room.boss{box-shadow:inset 0 0 26px rgba(121,25,25,.52)}
.room h3{color:#efd49a;text-shadow:0 1px 0 #000}.room .cap{color:#9f8e72}
.room{background-size:cover;background-position:center center;background-repeat:no-repeat}
.room.gateway{background-image:linear-gradient(rgba(8,8,10,.10),rgba(8,8,10,.18)),url("data:image/webp;base64,");background-position:center center}
.room.hall{background-image:linear-gradient(rgba(8,8,10,.10),rgba(8,8,10,.18)),url("data:image/webp;base64,");background-position:center center}