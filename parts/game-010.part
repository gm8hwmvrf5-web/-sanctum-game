  text-align:center;
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  .mpDemonReaderCard{
    width:min(900px,98vw) !important;
    grid-template-columns:minmax(150px,29%) minmax(0,1fr) !important;
  }
  .mpDemonRoomHeader{margin:0 60px 4px 0;padding-bottom:3px}
  .mpDemonRoomHeader b{font-size:12px}
  .mpDemonRoomHeader span{font-size:6.5px}
