}
.mpDemonRoomOption.active{
  border-color:#b98b45;
  box-shadow:0 0 0 2px rgba(185,139,69,.18),inset 0 0 14px rgba(185,139,69,.1);
  background:#21160f;
}
.mpDemonRoomOptionArt{
  width:100%;
  height:68px;
  overflow:hidden;
  border:1px solid #5c432d;
  border-radius:6px;
  background:#090706;
}
.mpDemonRoomOptionArt img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 25%;
  display:block;
}
.mpDemonRoomOptionName{
  margin-top:4px;
  overflow:hidden;
  text-overflow:ellipsis;
