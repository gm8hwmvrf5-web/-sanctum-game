<style id="multiplayerDemonStatsFivePercentPatch">
/* Visual-only multiplayer patch: smaller labels, numbers +5% from the prior size. */
#boardSection .demonStats{
  font-size:11.235px !important;
}
#boardSection .demonStats .statLabel{
  font-size:.70em !important;
}
#boardSection .demonStats .statValue{
  font-size:1.05em !important;
}
@media (max-width:700px){
  #boardSection .demonStats{
    font-size:12.81px !important;
  }
  #boardSection .demonStats .statLabel{
    font-size:.55em !important;
  }
  #boardSection .demonStats .statValue{
    font-size:1.05em !important;
  }
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #boardSection .demonStats{
    font-size:5.565px !important;
  }
  #boardSection .demonStats .statLabel{
    font-size:3.2px !important;
  }
  #boardSection .demonStats .statValue{
    font-size:5.843px !important;
  }
}
</style>

<style id="sanctumMultiplayerLobbyStyles">
#sanctumOnlinePanel{
  margin:10px 0;
  padding:10px;
  border:1px solid #7c6339;
  border-radius:9px;
  background:linear-gradient(180deg,#17120f,#0d0b0a);
  box-shadow:inset 0 0 16px rgba(0,0,0,.35);
}
#sanctumOnlinePanel .mpTitle{
  color:#efd39b;
  font-weight:800;
  letter-spacing:.8px;
  text-transform:uppercase;
  margin-bottom:7px;
}
#sanctumOnlinePanel .mpActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  align-items:end;
}
#sanctumOnlinePanel .mpField label{
  display:block;
  font-size:9px;
  color:#ad9c7d;
  letter-spacing:.6px;
  text-transform:uppercase;
  margin-bottom:2px;
}
#sanctumOnlinePanel input{
  width:100%;
  box-sizing:border-box;
  background:#0a0909;
  color:#f1dfbc;
  border:1px solid #6e5530;
  border-radius:6px;
  padding:7px 8px;
  text-transform:uppercase;
}
#sanctumOnlinePanel .mpButtons{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-top:7px;
}
#sanctumOnlinePanel .mpButtons .btn{flex:1 1 120px}
#sanctumOnlinePanel .mpStatus{
  margin-top:8px;
  padding:7px 8px;
  border-radius:6px;
  background:#0a0a0b;
  color:#c9bda6;
  font-size:11px;
  line-height:1.35;
}
#sanctumOnlinePanel .mpRoomCode{
  color:#f2c66f;
  font-weight:900;
  letter-spacing:2px;
}
#sanctumOnlinePanel .mpRoster{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:5px;
  margin-top:7px;
}
#sanctumOnlinePanel .mpSeat{
  border:1px solid #4e402d;
  border-radius:6px;
  padding:5px;
  min-height:34px;
  background:#12100e;
  color:#d8c9ae;
  font-size:9px;
}
#sanctumOnlinePanel .mpSeat b{
  display:block;
  color:#edcf95;
  font-size:10px;
}
#sanctumOnlinePanel .mpSeat.empty{opacity:.45}
#sanctumOnlinePanel .mpDevNote{
  margin-top:6px;
  color:#8f816e;
  font-size:9px;
  line-height:1.3;
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #sanctumOnlinePanel{margin:4px 0;padding:5px}
  #sanctumOnlinePanel .mpTitle{font-size:9px;margin-bottom:3px}
  #sanctumOnlinePanel .mpActions{gap:4px}
  #sanctumOnlinePanel input{min-height:28px!important;padding:3px 5px!important;font-size:8px!important}
  #sanctumOnlinePanel .mpButtons{margin-top:3px;gap:3px}
  #sanctumOnlinePanel .mpButtons .btn{min-height:28px!important;padding:3px 5px!important;font-size:8px!important}
  #sanctumOnlinePanel .mpStatus{margin-top:4px;padding:4px;font-size:8px}
  #sanctumOnlinePanel .mpRoster{margin-top:4px;gap:3px}
  #sanctumOnlinePanel .mpSeat{min-height:22px;padding:3px;font-size:7px}
  #sanctumOnlinePanel .mpSeat b{font-size:8px}
  #sanctumOnlinePanel .mpDevNote{display:none}
}

.mpGameBanner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin:6px 0;
  padding:6px 9px;
  border:1px solid #6b5735;
  border-radius:7px;
  background:#11100e;
  color:#cfc0a5;
  font-size:10px;
  letter-spacing:.35px;
}
.mpGameBanner b{color:#efca7f;letter-spacing:1px}
.mpGameBanner.yourTurn{
  border-color:#4f845d;
  box-shadow:inset 0 0 10px rgba(55,115,73,.18);
}
.mpGameBanner.yourTurn span{color:#a9d6ad;font-weight:700}
.mpGameBanner.waiting span{color:#b4a58d}
.mpGameBanner.ended{
  border-color:#87413b;
  background:#1a0d0c;
}
.mpGameBanner.ended b{color:#ef8c82}
.mpGameBanner.ended span{color:#d9b2aa}
body.mpSessionEnded #handPanel,
body.mpSessionEnded #ritualPanel,
body.mpSessionEnded #boardSection{
  filter:saturate(.45) brightness(.68);
}
body.mpWaitingTurn #handPanel .card{
  filter:none !important;
  opacity:1 !important;
}
body.mpWaitingTurn #ritualPanel .ritual{filter:saturate(.72) brightness(.82)}

/* Multiplayer viewport-height fill.
   visualViewport updates --sanctum-viewport-height so iPhone standalone/Safari
   uses the actually visible screen instead of a stale 100vh measurement. */
html,body{
  min-height:var(--sanctum-viewport-height,100dvh) !important;
}
body > .app{
  box-sizing:border-box !important;
  min-height:var(--sanctum-viewport-height,100dvh) !important;
}
@supports not (height:100dvh){
  html,body,body > .app{min-height:100vh !important;}
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  body{
    min-height:var(--sanctum-viewport-height,100dvh) !important;
  }
  body > .app{
    min-height:var(--sanctum-viewport-height,100dvh) !important;
    display:flex !important;
    flex-direction:column !important;
  }
  body > .app > .main,
  body > .app > #handPanel{
    flex:1 0 auto !important;
  }
  #handPanel{
    box-sizing:border-box !important;
  }
}
#handPanel.mpOwnHand .mpOwnHandLabel{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin:0 0 5px;
  padding:4px 7px;
  border:1px solid #5f4b2d;
  border-radius:6px;
  background:rgba(18,14,11,.82);
  color:#bbaa8c;
  font-size:9px;
  letter-spacing:.35px;
}
#handPanel.mpOwnHand .mpOwnHandLabel b{
  color:#efcc86;
  letter-spacing:1px;
}
#handPanel.mpOwnHand .mpOwnHandLabel span{
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
body.mpWaitingTurn #handPanel.mpOwnHand .mpOwnHandLabel:after{
  content:"Locked until your turn";
  color:#9b8b74;
  font-size:8px;
  white-space:nowrap;
}
dialog.mpDemonReader{
  position:fixed;
  inset:0;
  width:100vw;
  height:100vh;
  max-width:none;
  max-height:none;
  margin:0;
  padding:18px;
  border:0;
  background:rgba(0,0,0,.38);
  color:inherit;
  box-sizing:border-box;
}
dialog.mpDemonReader[open]{
  display:flex;
  align-items:center;
  justify-content:center;
}
dialog.mpDemonReader::backdrop{
  background:rgba(0,0,0,.82);
  backdrop-filter:blur(3px);
}
.mpDemonReaderCard{
  position:relative;
  width:min(760px,94vw);
  max-height:90vh;
  display:grid;
  grid-template-columns:minmax(220px,42%) 1fr;
  gap:14px;
  padding:14px;
  overflow:auto;
  border:1px solid #8b6737;
  border-radius:12px;
  background:linear-gradient(180deg,#211814,#100c0b);
  box-shadow:0 18px 55px rgba(0,0,0,.75),inset 0 0 24px rgba(181,125,57,.08);
}
.mpDemonReaderClose{
  position:absolute;
  top:8px;
  right:8px;
  z-index:2;
  min-width:68px;
  padding:7px 10px;
  border:1px solid #8d6741;
  border-radius:7px;
  background:#241710;
  color:#f1d5a4;
  font:700 12px Georgia,serif;
  cursor:pointer;
}
.mpDemonReaderArt{
  min-height:300px;
  overflow:hidden;
  border:1px solid #74552d;
  border-radius:9px;
  background:#0c0908;
}
.mpDemonReaderArt img{
  display:block;
  width:100%;
  height:100%;
  min-height:300px;
  object-fit:cover;
  object-position:center 28%;
}
.mpDemonReaderBody{
  min-width:0;
  padding:24px 4px 4px;
}
.mpDemonReaderType{
  margin-bottom:5px;
  color:#9e8a70;
  font-size:10px;
  letter-spacing:1.4px;
  text-transform:uppercase;
}
.mpDemonReaderName{
  margin:0 72px 12px 0;
  color:#f3d8a6;
  font-size:24px;
  line-height:1.05;
  font-weight:800;
}
.mpDemonReaderStats{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-bottom:14px;
  font-size:17px;
  font-weight:800;
}
.mpDemonReaderStats .hp{color:#ff9db4}
.mpDemonReaderStats .blood{color:#e33a49}
.mpDemonReaderStats .attack{color:#fff}
.mpDemonReaderAbility{
  padding:11px 12px;
  border:1px solid #57432e;
  border-radius:8px;
  background:rgba(0,0,0,.22);
  color:#f1e6d3;
  font-size:15px;
  line-height:1.45;
}
#boardSection [data-demon]{
  position:relative !important;
  cursor:zoom-in;
  touch-action:manipulation !important;
  -webkit-tap-highlight-color:rgba(239,202,127,.22);
  pointer-events:auto !important;
}
#boardSection .mpDemonTapTarget{
  position:absolute !important;
  inset:0 !important;
  z-index:80 !important;
  width:100% !important;
  height:100% !important;
  margin:0 !important;
  padding:0 !important;
  border:0 !important;
  border-radius:inherit !important;
  background:transparent !important;
  opacity:0 !important;
  display:block !important;
  pointer-events:auto !important;
  touch-action:manipulation !important;
  -webkit-appearance:none !important;
  appearance:none !important;
}

@media (max-width:620px) and (orientation:portrait){
  .mpDemonReaderCard{grid-template-columns:1fr}
  .mpDemonReaderArt{min-height:220px}
  .mpDemonReaderArt img{min-height:220px;max-height:42vh}
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  .mpGameBanner{margin:2px 0;padding:2px 5px;font-size:7px;min-height:16px}
  .mpDemonReader{padding:6px}
  .mpDemonReaderCard{
    width:min(700px,96vw);
    max-height:94vh;
    grid-template-columns:minmax(170px,36%) 1fr;
    gap:8px;
    padding:8px;
  }
  .mpDemonReaderArt,.mpDemonReaderArt img{min-height:210px}
  .mpDemonReaderBody{padding:16px 2px 2px}
  .mpDemonReaderName{font-size:18px;margin-bottom:8px}
  .mpDemonReaderStats{font-size:14px;gap:9px;margin-bottom:8px}
  .mpDemonReaderAbility{font-size:11px;line-height:1.35;padding:7px}
  .mpDemonReaderClose{top:5px;right:5px;min-width:58px;padding:5px 8px;font-size:10px}
}
</style>


<style id="multiplayerBossReaderPatch">
/* Boss cards use a tap target like Demon cards and crop the full boss-card source
   down to the illustration window so printed card text never appears as artwork. */
#boardSection .bossCard{
  position:relative !important;
  cursor:zoom-in !important;
  touch-action:manipulation !important;
  -webkit-tap-highlight-color:rgba(239,202,127,.22) !important;
}
#boardSection .mpBossTapTarget{
  position:absolute !important;
  inset:0 !important;
  z-index:80 !important;
  width:100% !important;
  height:100% !important;
  margin:0 !important;
  padding:0 !important;
  border:0 !important;
  border-radius:inherit !important;
  background:transparent !important;
  opacity:0 !important;
  display:block !important;
  pointer-events:auto !important;
  touch-action:manipulation !important;
  -webkit-appearance:none !important;
  appearance:none !important;
}
#boardSection .bossArt{
  object-fit:cover !important;
  object-position:center 32% !important;
}
dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderCard{
  border-color:#9e3a30 !important;
  background:linear-gradient(180deg,#27100f,#100908) !important;
}
dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderArt{
  min-height:0 !important;
  aspect-ratio:4 / 3 !important;
  align-self:start !important;
  background:#090606 !important;
  border-color:#8f3d35 !important;
}
dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderArt img{
  width:100% !important;
  height:100% !important;
  min-height:0 !important;
  max-height:none !important;
  object-fit:cover !important;
  object-position:center 32% !important;
}
dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderType{
  color:#d9a17c !important;
}
dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderStats .blood{
  color:#f06464 !important;
}
.mpBossReaderRules{
  display:grid;
  gap:7px;
}
.mpBossReaderRule{
  padding:8px 9px;
  border:1px solid #5b302d;
  border-radius:7px;
  background:rgba(79,18,18,.16);
  color:#f1e6d3;
  font-size:13px;
  line-height:1.4;
}
.mpBossReaderRule b{color:#e8ad82}
.mpBossReaderMeta{
  grid-column:1/-1;
  padding:8px 9px;
  border:1px solid #5b302d;
  border-radius:7px;
  background:#180c0b;
  color:#bda98e;
  font-size:10px;
  line-height:1.35;
  text-align:center;
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #boardSection .bossArt{
    height:66px !important;
    aspect-ratio:auto !important;
    object-fit:cover !important;
    object-position:center 32% !important;
    margin-bottom:2px !important;
  }
  dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderArt{
    min-height:0 !important;
    aspect-ratio:4 / 3 !important;
  }
  dialog.mpDemonReader[data-reader-kind="boss"] .mpDemonReaderArt img{
    min-height:0 !important;
    height:100% !important;
    object-fit:cover !important;
    object-position:center 32% !important;
  }
  .mpBossReaderRule{font-size:10px;line-height:1.3;padding:5px 6px}
  .mpBossReaderMeta{font-size:8px;padding:5px 6px}
}
</style>

<style id="multiplayerGroupVoteStyles">
#rogueChoiceModal[data-mp-group-vote="1"] .modalbox{
  width:min(980px,96vw) !important;
}
.mpGroupVoteIntro{
  margin-top:8px;
  padding:8px 10px;
  border:1px solid #6d5736;
  border-radius:8px;
  background:#12100e;
  color:#d7c5a3;
  font-size:11px;
  line-height:1.35;
}
