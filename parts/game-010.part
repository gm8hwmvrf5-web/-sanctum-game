}
#rogueChoiceModal .rogueChoice.mpGroupVoteOption.mpMyVote{
  border-color:#75a7d8 !important;
  box-shadow:0 0 0 2px rgba(92,156,214,.18),inset 0 0 18px rgba(73,132,183,.12) !important;
}
.mpVoteCount{
