}
</style>

<style id="multiplayerRoomDemonReaderStyles">
.mpDemonReaderCard{
  width:min(940px,96vw) !important;
  grid-template-columns:minmax(220px,36%) minmax(0,1fr) !important;
}
.mpDemonReaderBody{
  display:flex;
  flex-direction:column;
  min-height:0;
}
.mpDemonRoomHeader{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:10px;
  margin:0 74px 9px 0;
  padding-bottom:7px;
  border-bottom:1px solid #4d3929;
}
.mpDemonRoomHeader b{
  color:#f2d39a;
  font-size:16px;
  letter-spacing:.8px;
}
.mpDemonRoomHeader span{
  color:#9e8a70;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:1px;
  white-space:nowrap;
}
.mpDemonRoomList{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(112px,1fr));
  gap:7px;
  margin-top:12px;
  padding-top:10px;
  border-top:1px solid #4d3929;
}
.mpDemonRoomOption{
  min-width:0;
  padding:5px;
  border:1px solid #4f3b2b;
  border-radius:8px;
  background:#130f0d;
  color:#ead9bd;
  text-align:left;
