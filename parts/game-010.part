  #priestDeckModal .priestDeckReferenceArt{aspect-ratio:2/1;}
  #priestDeckModal .priestDeckReferenceBody{padding:5px;}
  #priestDeckModal .priestDeckReferenceName{font-size:9px;}
  #priestDeckModal .priestDeckReferenceCost{font-size:6.5px;}
  #priestDeckModal .priestDeckReferenceEffect{font-size:7px;line-height:1.25;margin-top:3px;padding-top:3px;}
}
