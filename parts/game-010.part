}
@media(max-width:620px){
  #priestDeckModal .priestDeckBox{width:97vw;padding:9px;}
  #priestDeckModal .priestDeckTop{top:-9px;margin:-9px -9px 9px;padding:9px;}
  #priestDeckModal .priestDeckGrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;}
  #priestDeckModal .priestDeckReferenceBody{padding:6px;}
  #priestDeckModal .priestDeckReferenceName{font-size:11px;}
  #priestDeckModal .priestDeckReferenceCost{font-size:7px;padding:2px 5px;}
  #priestDeckModal .priestDeckReferenceEffect{font-size:8px;line-height:1.3;margin-top:4px;padding-top:4px;}
}
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #priestDeckModal .priestDeckBox{
    width:98vw;
