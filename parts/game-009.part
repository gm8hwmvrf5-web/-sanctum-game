  #handContent .hand.carouselTrack > .card .actions button{
    min-height:21px !important;
    height:21px !important;
    font-size:6px !important;
    padding:1px !important;
  }
}

/* Slightly smaller hand and a larger Priest pane on tablets/desktops too. */
@media (min-width:1001px){
  #handPanel .handCharacterStage{
    grid-template-columns:minmax(0,43%) minmax(0,57%) !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode{
