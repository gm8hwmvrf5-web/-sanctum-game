    gap:2px !important;
  }
  #handPanel .handCharacterPriest .priestRelicTopStack > #relicXpMeterStat b{
    font-size:7.2px !important;
  }
  #handPanel .handCharacterPriest .priestRelicTopStack > #relicXpMeterStat span{
    font-size:5px !important;
  }

  /* Basic Attack / End Turn: another 25% smaller than the current 49x18 controls. */
  #handPanel .handCharacterPriest .ritualTracker #basicBtn,
  #handPanel .handCharacterPriest .ritualTracker #endBtn{
    min-width:37px !important;
    width:37px !important;
    max-width:37px !important;
    min-height:14px !important;
    height:14px !important;
    padding:0 1px !important;
    font-size:4.8px !important;
    line-height:1 !important;
    border-radius:4px !important;
  }
  #handPanel .handCharacterPriest .ritualTracker{
    min-height:14px !important;
    margin-bottom:0 !important;
  }

  /* Anchor Priest-card buttons to the actual bottom edge of each card. */
  #handContent .hand.carouselTrack > .card{
    position:relative !important;
  }
  #handContent .hand.carouselTrack > .card .cardBottom{
    position:static !important;
  }
  #handContent .hand.carouselTrack > .card .actions,
  #handContent .hand.carouselTrack > .card .cardBottom .actions{
    position:absolute !important;
