<style id="simpleSandTimerV17Patch">
/* Reuse the existing timer box: sand accumulates from the bottom while
   a lightweight animated stream falls into it. No layout dimensions change. */
.turnTimerStat,
#turnTimerStatBox{
  --sand-fill:0%;
  position:relative !important;
  overflow:hidden !important;
  isolation:isolate !important;
  background:
    radial-gradient(circle at 50% 28%,rgba(202,158,79,.06),transparent 42%),
    linear-gradient(180deg,#17140f,#0b0a08) !important;
  border-color:#8d7548 !important;
}

/* Retire the old liquid timer fill without touching the actual timer logic. */
.turnTimerStat .turnTimerFill,
#turnTimerStatBox .turnTimerFill{
  opacity:0 !important;
  visibility:hidden !important;
}

.turnTimerSandPile{
  position:absolute;
  z-index:1;
  left:0;
  right:0;
  bottom:0;
  height:var(--sand-fill);
  pointer-events:none;
  overflow:visible;
  background:
    radial-gradient(circle at 20% 26%,rgba(255,226,157,.80) 0 1px,transparent 1.4px),
    radial-gradient(circle at 63% 56%,rgba(218,166,80,.78) 0 1px,transparent 1.5px),
    radial-gradient(circle at 82% 22%,rgba(255,239,185,.62) 0 1px,transparent 1.4px),
    linear-gradient(180deg,#e9bd68 0%,#c78c3f 46%,#8c5728 100%);
  background-size:11px 10px,13px 12px,17px 14px,100% 100%;
  box-shadow:
    inset 0 3px 4px rgba(255,230,166,.24),
    0 -1px 4px rgba(221,164,73,.26);
  transition:height .3s linear;
}
.turnTimerSandPile::before{
  content:"";
  position:absolute;
  left:10%;
  right:10%;
  top:-3px;
  height:7px;
  border-radius:50% 50% 30% 30%;
  background:linear-gradient(180deg,#f1c974,#b87935);
  box-shadow:0 -1px 3px rgba(246,207,126,.28);
}

.turnTimerSandStream{
  position:absolute;
  z-index:2;
  top:0;
  left:50%;
  width:4px;
  bottom:var(--sand-fill);
  min-height:2px;
  transform:translateX(-50%);
  pointer-events:none;
  overflow:hidden;
  opacity:.94;
}
.turnTimerSandStream::before{
  content:"";
  position:absolute;
  inset:-12px 0 0;
  background:
    radial-gradient(circle,#ffd98a 0 1px,transparent 1.35px) 50% 0/4px 7px repeat-y,
    radial-gradient(circle,#c98f42 0 .8px,transparent 1.2px) 25% 2px/4px 9px repeat-y;
  animation:sanctumSandFall .42s linear infinite;
}
.turnTimerSandStream::after{
  content:"";
  position:absolute;
  left:1px;
  top:0;
  bottom:0;
  width:1px;
  background:linear-gradient(180deg,rgba(255,224,147,.25),#e0a751 48%,rgba(185,119,48,.38));
}

.turnTimerSandSpecks{
  position:absolute;
  z-index:2;
  inset:0;
  pointer-events:none;
  opacity:.6;
  background:
    radial-gradient(circle at 46% 18%,#edbc65 0 .8px,transparent 1.1px),
    radial-gradient(circle at 55% 38%,#ffd98b 0 .7px,transparent 1px),
    radial-gradient(circle at 49% 63%,#c9883b 0 .8px,transparent 1.1px);
  background-size:17px 23px,19px 29px,23px 31px;
  animation:sanctumSandSpecks .85s linear infinite;
}

.turnTimerStat.sandPaused .turnTimerSandStream,
.turnTimerStat.sandPaused .turnTimerSandSpecks,
#turnTimerStatBox.sandPaused .turnTimerSandStream,
#turnTimerStatBox.sandPaused .turnTimerSandSpecks{
  animation-play-state:paused !important;
  opacity:.18;
}
.turnTimerStat.sandFinished .turnTimerSandStream,
#turnTimerStatBox.sandFinished .turnTimerSandStream{
  display:none !important;
}

.turnTimerStat b,
.turnTimerStat span,
#turnTimerStatBox b,
#turnTimerStatBox span,
#turnTimerStatValue{
  position:relative !important;
  z-index:6 !important;
  text-shadow:0 1px 2px #000,0 0 4px rgba(0,0,0,.72) !important;
}

@keyframes sanctumSandFall{
  from{transform:translateY(-10px)}
  to{transform:translateY(11px)}
}
@keyframes sanctumSandSpecks{
  from{background-position:0 -18px,4px -28px,-3px -32px}
  to{background-position:0 14px,4px 18px,-3px 20px}
}

@media (prefers-reduced-motion:reduce){
  .turnTimerSandStream::before,
  .turnTimerSandSpecks{animation:none !important}
}
</style>

<script id="simpleSandTimerV17Script">
(()=>{
  'use strict';

  let observedMax=0;
  let lastRemaining=null;

  function findTimerBox(){
    let box=document.querySelector('.turnTimerStat,#turnTimerStatBox');
    if(box)return box;

    const value=document.getElementById('turnTimerStatValue')||
                document.getElementById('turnTimerStat')||
                document.getElementById('turnTimer');
    if(value)return value.closest('.stat')||value.parentElement;

    return [...document.querySelectorAll('#topStatusBar .stat,.stats .stat')]
      .find(el=>/turn\s*timer|timer/i.test(el.textContent||''))||null;
  }

  function ensureSand(box){
    if(!box)return;
    box.classList.add('turnTimerStat');
    if(!box.querySelector('.turnTimerSandPile')){
      const pile=document.createElement('div');
      pile.className='turnTimerSandPile';
      const stream=document.createElement('div');
      stream.className='turnTimerSandStream';
      const specks=document.createElement('div');
      specks.className='turnTimerSandSpecks';
      box.prepend(specks);
      box.prepend(stream);
      box.prepend(pile);
    }
  }

  function numericTimerValue(box){
    try{
      if(typeof S!=='undefined'&&S&&Number.isFinite(Number(S.turnTimerRemaining))){
        return Math.max(0,Number(S.turnTimerRemaining));
      }
    }catch(_){}

    const preferred=document.getElementById('turnTimerStatValue');
    const text=(preferred||box.querySelector('b')||box).textContent||'';
    const m=text.match(/\d+(?:\.\d+)?/);
    return m?Math.max(0,Number(m[0])):null;
  }

  function timerMaximum(remaining){
    try{
      if(typeof TURN_TIMER_SECONDS!=='undefined'&&Number(TURN_TIMER_SECONDS)>0){
        return Number(TURN_TIMER_SECONDS);
      }
    }catch(_){}

    if(lastRemaining!==null&&remaining>lastRemaining+1)observedMax=remaining;
    observedMax=Math.max(observedMax,remaining||0,1);
    return observedMax;
  }

  function updateSand(){
    const box=findTimerBox();
    if(!box)return;
    ensureSand(box);

    const remaining=numericTimerValue(box);
    if(remaining===null)return;

    const max=Math.max(1,timerMaximum(remaining));
    const elapsed=Math.max(0,Math.min(1,1-(remaining/max)));
    box.style.setProperty('--sand-fill',(elapsed*100).toFixed(2)+'%');

    const paused=!!(
      document.hidden||
      window.__sanctumManualPaused||
      (typeof S!=='undefined'&&S&&S.manualPaused)
    );
    box.classList.toggle('sandPaused',paused);
    box.classList.toggle('sandFinished',remaining<=0);

    lastRemaining=remaining;
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',updateSand,{once:true});
  }else{
    updateSand();
  }

  /* Timer updates once per second; this stays intentionally lightweight. */
  setInterval(updateSand,250);
})();
</script>

<script id="sanctumPwaRegistration">
if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./service-worker.js').catch(() => {});
  });
}
</script>

</body>
</html>