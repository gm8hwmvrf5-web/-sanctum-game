  }
  #handPanel .handCharacterPriest .rituals{
    margin-top:0 !important;
  }
}
</style>


<style id="iphoneLandscapeTighterPriestUiV2Patch">
/* Dedicated iPhone landscape refinements requested after the tighter Priest UI pass. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){

  /* XP bar: another 10% thinner than 12px => ~11px. */
