    padding-bottom:4px !important;
  }
}
</style>


<style id="iphoneLandscapeCompactStatAndWiderPriestPatch">
/* Dedicated iPhone landscape refinements:
   - middle status/timer/altar bar ~50% thinner
   - hand area centered in its pane, then nudged left
   - Priest dashboard given slightly more width
   - reduced vertical whitespace so everything below the board moves upward */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){

  /* About half the previous 34px stat-card thickness. */
  #topStatusBar.stats{
    gap:2px !important;
    margin:2px 0 !important;
    padding:1px !important;
    border-radius:5px !important;
  }
  #topStatusBar .stat{
    min-height:18px !important;
    height:18px !important;
    padding:0 2px !important;
    border-radius:4px !important;
  }
  #topStatusBar .stat b{
    font-size:8px !important;
    line-height:1 !important;
    margin:0 !important;
  }
  #topStatusBar .stat > span{
    font-size:4.6px !important;
    line-height:1 !important;
    letter-spacing:.15px !important;
  }
  #topStatusBar .runProgressStat{
    padding:0 3px !important;
  }
  #topStatusBar .runProgressPair{
    gap:2px !important;
  }
  #topStatusBar .runProgressChunk em{
    font-size:4.3px !important;
    line-height:1 !important;
  }
  #topStatusBar .runProgressChunk strong{
    font-size:6.8px !important;
    line-height:1 !important;
  }
  #topStatusBar .runProgressDivider{
    height:10px !important;
  }

  /* Bring the whole hand/Priest block closer to the stat bar. */
  #handPanel{
    margin:2px 0 !important;
    padding:4px !important;
  }

  /* Slightly wider Priest UI. */
  #handPanel .handCharacterStage{
    grid-template-columns:minmax(0,52%) minmax(305px,48%) !important;
    gap:4px !important;
  }

  /* Center the Priest-card fan in its own left pane, then nudge it left. */
  #handPanel .handCharacterCards{
    display:flex !important;
    align-items:center !important;
    justify-content:center !important;
    min-width:0 !important;
  }
  #handPanel .handCharacterCards #handContent{
    width:100% !important;
    min-width:0 !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode{
    margin-left:auto !important;
    margin-right:auto !important;
    transform:translateX(-10px) !important;
  }
}

/* Keep the same proportions on shorter SE/8-class landscape screens. */
@media (orientation:landscape) and (max-height:380px) and (max-width:850px){
  #handPanel .handCharacterStage{
    grid-template-columns:minmax(0,52%) minmax(300px,48%) !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode{
    transform:translateX(-8px) !important;
  }
}
</style>


<style id="iphoneLandscapeVerticalCenterPriestCardsPatch">
/* Center the Priest-card fan vertically within the full left-side landscape pane. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #handPanel .handCharacterStage{
    align-items:stretch !important;
  }

  #handPanel .handCharacterCards{
    align-self:stretch !important;
    height:100% !important;
    min-height:100% !important;
    display:flex !important;
    align-items:center !important;
    justify-content:center !important;
  }

  #handPanel .handCharacterCards #handContent{
    width:100% !important;
    display:flex !important;
    flex-direction:column !important;
    justify-content:center !important;
    align-items:stretch !important;
  }

  #handContent .handCarousel.twoFrontMode.fourVisibleMode{
    margin-top:auto !important;
    margin-bottom:auto !important;
  }
}
</style>



<style id="iphoneLandscapePriestWidthMenuV3Patch">
/* iPhone landscape: 10% narrower Priest cards, larger Priest dashboard,
   and one compact Menu button aligned with Basic Attack / End Turn. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  /* Give more of the lower play area to the Priest UI. */
  #handPanel .handCharacterStage{
    grid-template-columns:minmax(0,48%) minmax(0,52%) !important;
    gap:4px !important;
  }

  /* Front Priest cards: 134px -> 121px (~10% narrower), height unchanged. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode{
    max-width:383px !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack{
    width:329px !important;
    max-width:329px !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-right{
    width:121px !important;
    min-width:121px !important;
    max-width:121px !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center{
    left:38px !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-right{
    left:165px !important;
  }

  /* Rear preview cards scale with the narrower fan. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-left,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-right{
    width:96px !important;
    min-width:96px !important;
    max-width:96px !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-left{
    left:0 !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-right{
    left:233px !important;
  }

  /* One action row: Basic Attack | End Turn | Menu, with Menu pinned right. */
  #handPanel .handCharacterPriest .ritualTracker{
    display:flex !important;
    align-items:center !important;
    flex-wrap:nowrap !important;
    gap:4px !important;
    min-height:20px !important;
  }
  #handPanel .handCharacterPriest .ritualTracker #basicBtn,
  #handPanel .handCharacterPriest .ritualTracker #endBtn,
  #handPanel .handCharacterPriest .ritualTracker #iphonePauseMenuBtn{
    width:auto !important;
    max-width:none !important;
    min-width:54px !important;
    min-height:20px !important;
    height:20px !important;
    padding:1px 4px !important;
    font-size:6.4px !important;
    line-height:1 !important;
    border-radius:4px !important;
    white-space:nowrap !important;
  }
  #handPanel .handCharacterPriest .ritualTracker #iphonePauseMenuBtn{
    margin-left:auto !important;
    min-width:46px !important;
  }

  /* The old phone-nav pause entry is replaced by the Priest-UI Menu button. */
  #mobilePauseMenuBtn{display:none !important;}
}

/* Keep shorter iPhones usable while still enlarging the Priest side. */
@media (orientation:landscape) and (max-height:380px) and (max-width:850px){
  #handPanel .handCharacterStage{
    grid-template-columns:minmax(0,49%) minmax(0,51%) !important;
  }
}
</style>

<script id="iphonePriestPauseMenuButtonV3Script">
(()=>{
  'use strict';
  const iphoneLandscape=()=>window.matchMedia('(orientation:landscape) and (max-height:520px) and (max-width:1000px)').matches;

  function ensurePriestMenuButton(){
    const existing=document.getElementById('iphonePauseMenuBtn');
    if(!iphoneLandscape()){
      if(existing)existing.remove();
      return;
    }

    const tracker=document.querySelector('#handPanel .handCharacterPriest .ritualTracker');
    if(!tracker)return;

    let btn=existing;
    if(!btn){
      btn=document.createElement('button');
      btn.type='button';
      btn.id='iphonePauseMenuBtn';
      btn.className='btn trackerAction';
      btn.textContent='Menu';
      btn.setAttribute('aria-label','Open pause menu');
      btn.addEventListener('click',()=>{
        if(typeof window.openGameMenu==='function')window.openGameMenu();
      });
    }

    // Keep the single Menu button at the far right of the same row.
    if(btn.parentElement!==tracker)tracker.appendChild(btn);
    else tracker.appendChild(btn);
  }

  if(typeof renderPlayer==='function'){
    const priorRenderPlayer=renderPlayer;
    renderPlayer=function(){
      const out=priorRenderPlayer();
      ensurePriestMenuButton();
      return out;
    };
  }

  if(typeof rogueliteRenderHud==='function'){
    const priorRogueHud=rogueliteRenderHud;
    rogueliteRenderHud=function(){
      const out=priorRogueHud();
      ensurePriestMenuButton();
      return out;
    };
  }

  window.addEventListener('resize',ensurePriestMenuButton);
  window.addEventListener('orientationchange',()=>setTimeout(ensurePriestMenuButton,50));
  if(S?.started)ensurePriestMenuButton();
})();
</script>

<script id="sanctumPwaRegistration">
if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./service-worker.js').catch(() => {});
  });
}
</script>

</body>
</html>