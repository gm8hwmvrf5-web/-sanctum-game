    min-height:0 !important;
    margin:0 -4px -4px !important;
    padding:4px 4px 26px !important;
    border-radius:0 0 7px 7px !important;

    /* Preserve the original embedded parchment image; only normalize its
       sizing/blending so there is no flat-colored lower block. */
    background-size:cover !important;
    background-position:center center !important;
    background-repeat:no-repeat !important;
    background-blend-mode:multiply !important;
    border-top:1px solid rgba(111,78,30,.42) !important;
    overflow:hidden !important;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.24),
      inset 0 16px 24px rgba(120,85,35,.14),
      inset 0 0 44px rgba(84,54,18,.36),
      0 0 0 1px rgba(95,67,28,.22) !important;
