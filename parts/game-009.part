    border-radius:5px !important;
    white-space:normal !important;
  }

  /* Remove remaining air between actions, Ritual title, gauge and cards. */
  #handPanel .handCharacterPriest .ritualTracker{
    gap:3px !important;
    padding:0 !important;
    margin:0 0 1px !important;
    min-height:18px !important;
  }
  #handPanel .handCharacterPriest .ritualMain .ritualTitleWithBlood,
  #handPanel .handCharacterPriest .ritualMain > h3{
    margin:0 0 2px !important;
  }
