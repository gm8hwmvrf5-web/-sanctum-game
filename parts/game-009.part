    flex-direction:column !important;
    min-height:0 !important;
    position:static !important;
    margin:0 -4px -4px !important;
    padding:4px 4px 26px !important;
  }

  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center .cardBottom p:last-of-type,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-right .cardBottom p:last-of-type{
