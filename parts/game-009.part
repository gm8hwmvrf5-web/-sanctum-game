/* Device-aware full-viewport fitting. The normal layout is measured first,
   then uniformly reduced only when needed so the complete game remains visible. */
html.sanctumViewportFit,
body.sanctumViewportFit{
  width:100% !important;
  height:100% !important;
  min-height:100% !important;
  overflow:hidden !important;
}
body.sanctumViewportFit > .app{
  margin:0 !important;
  transform-origin:top left !important;
  will-change:transform;
}
</style>

<script id="universalViewportFitV11Script">
(()=>{
  'use strict';

  let fitFrame=0;
  let fitting=false;

  function viewportSize(){
    const vv=window.visualViewport;
    return {
      width:Math.max(1, vv ? vv.width : window.innerWidth),
      height:Math.max(1, vv ? vv.height : window.innerHeight),
      left:vv ? vv.offsetLeft : 0,
      top:vv ? vv.offsetTop : 0
    };
  }

  function activeOverlay(){
    return [...document.querySelectorAll(
      '.modal,#rogueTutorialIntro,#rogueTutorialCoach,#tutorialCoach,#tutorialWelcome'
    )].some(el=>{
      if(!el || el.classList.contains('hidden'))return false;
      const s=getComputedStyle(el);
      if(s.display==='none' || s.visibility==='hidden')return false;
      return el.getClientRects().length>0;
    });
  }

  function clearViewportFit(){
    const app=document.querySelector('body > .app') || document.querySelector('.app');
    document.documentElement.classList.remove('sanctumViewportFit');
    document.body.classList.remove('sanctumViewportFit');
    if(!app)return;
    [
      'position','left','top','width','max-width','transform','transform-origin'
    ].forEach(p=>app.style.removeProperty(p));
  }

  function fitViewportNow(){
    if(fitting)return;
    fitting=true;
    try{
      const app=document.querySelector('body > .app') || document.querySelector('.app');
      if(!app)return;

      /* Menus/popups should use their own full-viewport rules, not the scaled board. */
      if(activeOverlay()){
        clearViewportFit();
        return;
      }

      clearViewportFit();

      const v=viewportSize();
      const rect=app.getBoundingClientRect();
      const naturalW=Math.max(1,Math.ceil(app.scrollWidth),Math.ceil(rect.width));
      const naturalH=Math.max(1,Math.ceil(app.scrollHeight),Math.ceil(rect.height));

      let scale=Math.min(v.width/naturalW,v.height/naturalH,1);
      if(scale>0.985)scale=1;
      scale=Math.max(0.35,scale);

      const renderedW=naturalW*scale;
      const renderedH=naturalH*scale;
      const left=v.left+Math.max(0,(v.width-renderedW)/2);
      const top=v.top+Math.max(0,(v.height-renderedH)/2);

      document.documentElement.classList.add('sanctumViewportFit');
      document.body.classList.add('sanctumViewportFit');

      app.style.setProperty('position','fixed','important');
      app.style.setProperty('left',left+'px','important');
      app.style.setProperty('top',top+'px','important');
      app.style.setProperty('width',naturalW+'px','important');
      app.style.setProperty('max-width','none','important');
      app.style.setProperty('transform','scale('+scale+')','important');
      app.style.setProperty('transform-origin','top left','important');
    }finally{
      fitting=false;
    }
  }

  function scheduleViewportFit(){
    cancelAnimationFrame(fitFrame);
    fitFrame=requestAnimationFrame(()=>{
      fitViewportNow();
      /* Fonts/images can settle one frame later. */
      requestAnimationFrame(fitViewportNow);
    });
  }

  if(typeof renderPlayer==='function'){
    const priorRenderPlayer=renderPlayer;
    renderPlayer=function(){
      const out=priorRenderPlayer();
      scheduleViewportFit();
      return out;
    };
  }

  if(typeof renderBoard==='function'){
    const priorRenderBoard=renderBoard;
    renderBoard=function(){
      const out=priorRenderBoard();
      scheduleViewportFit();
      return out;
    };
  }

  window.addEventListener('resize',scheduleViewportFit);
  window.addEventListener('orientationchange',()=>setTimeout(scheduleViewportFit,80));
  if(window.visualViewport){
    visualViewport.addEventListener('resize',scheduleViewportFit);
    visualViewport.addEventListener('scroll',scheduleViewportFit);
  }

  const observer=new MutationObserver(mutations=>{
    if(mutations.some(m=>m.type==='childList' || (m.type==='attributes' && m.target!==document.body && m.target!==document.documentElement))){
      scheduleViewportFit();
    }
  });
  observer.observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['class']});

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',scheduleViewportFit,{once:true});
  }else{
    scheduleViewportFit();
  }
  window.addEventListener('load',scheduleViewportFit,{once:true});
})();
</script>

<script id="sanctumPwaRegistration">
if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./service-worker.js').catch(() => {});
  });
}
</script>

</body>
</html>