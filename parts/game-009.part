  }
  #handContent .hand.carouselTrack > .card .actions button{
    min-height:22px !important;
    height:22px !important;
    padding:1px 2px !important;
    font-size:6.5px !important;
  }

  /* Preserve a small text-safe area above the now-bottom-anchored buttons. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-right{
    padding-bottom:27px !important;
  }
}
</style>


<style id="iphoneLandscapePriestCardTextFillPatch">
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center .cardBottom,
