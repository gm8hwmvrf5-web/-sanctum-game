<style id="iphoneLandscapeUniformParchmentPatch">
/* Restore the original weathered parchment treatment across the whole lower
   face of the two playable front Priest cards. Keep text tight to the buttons. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){

  #handContent .handCarousel.twoFrontMode.fourVisibleMode
