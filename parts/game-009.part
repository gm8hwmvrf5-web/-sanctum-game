    left:3px !important;
    right:3px !important;
    bottom:2px !important;
    margin:0 !important;
    z-index:10 !important;
  }
}
</style>


<style id="iphoneLandscapeUniformParchmentPatch">
/* Restore the original weathered parchment treatment across the whole lower
   face of the two playable front Priest cards. Keep text tight to the buttons. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){

  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-center .cardBottom,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-right .cardBottom{
    position:relative !important;
    display:flex !important;
    flex:1 1 auto !important;
    flex-direction:column !important;
    min-height:0 !important;
    margin:0 -4px -4px !important;
    padding:4px 4px 26px !important;
    border-radius:0 0 7px 7px !important;

    /* Preserve the original embedded parchment image; only normalize its
       sizing/blending so there is no flat-colored lower block. */
    background-size:cover !important;
    background-position:center center !important;
    background-repeat:no-repeat !important;
    background-blend-mode:multiply !important;
    border-top:1px solid rgba(111,78,30,.42) !important;
    overflow:hidden !important;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.24),
      inset 0 16px 24px rgba(120,85,35,.14),
      inset 0 0 44px rgba(84,54,18,.36),
      0 0 0 1px rgba(95,67,28,.22) !important;
  }

  /* Make the existing weathering overlays belong to the parchment panel again. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-center .cardBottom::before,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-right .cardBottom::before,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-center .cardBottom::after,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-right .cardBottom::after{
    position:absolute !important;
    inset:0 !important;
    pointer-events:none !important;
  }

  /* Keep the final rules paragraph sitting immediately above the action row. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-center .cardBottom p:last-of-type,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-right .cardBottom p:last-of-type{
    margin-top:auto !important;
    margin-bottom:0 !important;
    padding-bottom:1px !important;
    background:transparent !important;
  }

  /* Buttons remain at the true bottom of the textured parchment face. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-center .actions,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-right .actions,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-center .cardBottom .actions,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode
  .hand.carouselTrack > .card.carouselCard.is-right .cardBottom .actions{
    position:absolute !important;
    left:3px !important;
    right:3px !important;
    bottom:2px !important;
    margin:0 !important;
    z-index:10 !important;
    background:transparent !important;
  }
}
</style>


<style id="iphoneLandscapeTrueCardBottomFix">
/* Final iPhone-landscape card fix: remove the redundant outer bottom padding.
   The weathered parchment body now reaches the true card bottom, and the
   action row remains directly beneath the final rules text. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center,
