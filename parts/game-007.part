<style id="tabMenuOnlyPatch">
/* The Tab menu is now the single game menu. Remove the persistent bottom toolbar. */
#topMenuBar{display:none !important;}
#pauseOverlay .pauseActions{
  display:grid !important;
  grid-template-columns:repeat(5,minmax(0,1fr)) !important;
  gap:7px !important;
}
#pauseOverlay .pauseActions .btn{min-width:0 !important;}
@media(max-width:900px){#pauseOverlay .pauseActions{grid-template-columns:repeat(3,minmax(0,1fr)) !important;}}
@media(max-width:560px){#pauseOverlay .pauseActions{grid-template-columns:repeat(2,minmax(0,1fr)) !important;}}
</style>
<script id="tabMenuOnlyScript">
(()=>{
  'use strict';
  function addMenuButton(id,label,handler,cls='btn'){
    const host=document.querySelector('#pauseOverlay .pauseActions');
    if(!host||document.getElementById(id))return;
    const b=document.createElement('button');
    b.type='button'; b.id=id; b.className=cls; b.textContent=label;
    b.addEventListener('click',handler);
    const resume=document.getElementById('resumeGameBtn');
    host.insertBefore(b,resume||null);
  }
  function clickExisting(id){const el=document.getElementById(id);if(el)el.click();}
  addMenuButton('pauseRulesBtn','Rules',()=>clickExisting('rulesBtn'));
  addMenuButton('pauseDemonDeckBtn','Demon Deck',()=>clickExisting('demonDeckBtn'));
  addMenuButton('pauseBossDeckBtn','Boss Deck',()=>clickExisting('bossDeckBtn'));
  addMenuButton('pauseRunGuideBtn','Run Guide',()=>{
    if(typeof rogueliteShowGuide==='function')rogueliteShowGuide();
    else clickExisting('tutorialBuildBadge');
  });
  addMenuButton('pauseLegacyBtn','Legacy',()=>{
    if(typeof rogueliteOpenLegacy==='function')rogueliteOpenLegacy(false);
    else clickExisting('rogueLegacyBtn');
  });
  // Keep Resume visually last.
  const host=document.querySelector('#pauseOverlay .pauseActions');
  const resume=document.getElementById('resumeGameBtn');
  if(host&&resume)host.appendChild(resume);
})();
</script>


<style id="rogueliteInteractiveTutorialStyles">
  #rogueTutorialIntro.hidden,#rogueTutorialCoach.hidden{display:none!important}
  #rogueTutorialIntro{position:fixed;inset:0;z-index:330;background:rgba(0,0,0,.86);display:grid;place-items:center;padding:16px}
  .rogueTutorialIntroCard{width:min(760px,96vw);max-height:90vh;overflow:auto;border:2px solid #9b7439;border-radius:15px;background:linear-gradient(180deg,#191416,#0d0b0d);padding:20px;box-shadow:0 0 40px #000;color:#dfd2ba}
  .rogueTutorialEyebrow{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#c9a35e;margin-bottom:5px}
  .rogueTutorialIntroCard h2{font-size:clamp(25px,5vw,39px);margin:0;color:#f0d39a}
  .rogueTutorialIntroCard p{line-height:1.5}
  .rogueTutorialGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:13px 0}
  .rogueTutorialMini{border:1px solid #5d492f;background:#14110f;border-radius:8px;padding:9px;font-size:12px;line-height:1.4}
  .rogueTutorialMini b{display:block;color:#ebca8a;margin-bottom:3px}
  .rogueTutorialIntroActions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
  .rogueTutorialIntroActions .btn{flex:1;min-width:180px;min-height:44px}
  #setupTutorialBtn{border-color:#b28a44;background:linear-gradient(#4a351c,#21170f);color:#f2d69c}
  #rogueTutorialCoach{position:fixed;z-index:310;left:14px;bottom:14px;width:min(500px,calc(100vw - 28px));border:2px solid #9b7439;border-radius:13px;background:linear-gradient(180deg,#1c1516,#0c0a0b);padding:13px;box-shadow:0 8px 28px rgba(0,0,0,.75);color:#e2d5bf}
  .rogueTutorialCoachTop{display:flex;align-items:center;justify-content:space-between;gap:8px}
  #rogueTutorialProgress{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:#c9a35e}
  #rogueTutorialCoach h3{margin:5px 0 6px;color:#f0d39a;font-size:20px}
  #rogueTutorialBody{font-size:12.5px;line-height:1.46}
  #rogueTutorialBody b{color:#f2d49b}
  #rogueTutorialTask{margin-top:8px;padding:7px 8px;border-left:3px solid #8d6b36;background:#15110e;border-radius:4px;font-size:11.5px;line-height:1.35;color:#cdbb99}
  #rogueTutorialTask.done{border-left-color:#5f936a;color:#acd3a5;background:#101712}
  .rogueTutorialActions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
  .rogueTutorialActions .btn{flex:1;min-width:94px;min-height:37px;padding:7px 8px}
  #rogueTutorialHelperBtn{border-color:#8a6533;background:linear-gradient(#3c2b18,#1d140d)}
  .rogueTutorialFocus{position:relative!important;z-index:305!important;outline:3px solid #e7c26d!important;outline-offset:4px!important;box-shadow:0 0 0 4px rgba(42,25,9,.75),0 0 24px rgba(231,194,109,.65)!important;border-radius:9px!important;scroll-margin-top:120px}
  body.rogue-tutorial-active #pauseOverlay{z-index:340}
  @media(max-width:720px){.rogueTutorialGrid{grid-template-columns:1fr}#rogueTutorialCoach{left:7px;bottom:64px;width:calc(100vw - 14px);padding:10px}#rogueTutorialCoach h3{font-size:17px}.rogueTutorialActions .btn{min-width:80px}}
</style>

<div id="rogueTutorialIntro" class="hidden" role="dialog" aria-modal="true" aria-labelledby="rogueTutorialIntroTitle">
  <div class="rogueTutorialIntroCard">
    <div class="rogueTutorialEyebrow">Optional Practice Run</div>
    <h2 id="rogueTutorialIntroTitle">Interactive Roguelite Tutorial</h2>
    <p>This is a short, playable practice encounter using the real game board and controls. The timer is paused while you learn, and the practice state is discarded when you finish or exit.</p>
    <div class="rogueTutorialGrid">
      <div class="rogueTutorialMini"><b>Play the Priest</b>Use a Priest card, Empower a pair, Basic Attack, and a Ritual.</div>
      <div class="rogueTutorialMini"><b>Read the Board</b>Defeat a Demon, watch Demon Blood and Relic XP, then end a turn.</div>
      <div class="rogueTutorialMini"><b>See the Roguelite Loop</b>Watch duplicate Demons merge and learn Floors, Bosses, Relics, and Cinders.</div>
    </div>
    <div class="notice"><b>No progress is kept:</b> tutorial Cinders, Relic XP, card draws, and board state are thrown away when you return to setup. Your Legacy currency is not spent or changed.</div>
    <div class="rogueTutorialIntroActions">
      <button class="btn green" id="rogueTutorialBeginBtn" type="button">Begin Practice Tutorial</button>
      <button class="btn" id="rogueTutorialBackBtn" type="button">Back to Setup</button>
    </div>
  </div>
</div>

<div id="rogueTutorialCoach" class="hidden" role="dialog" aria-live="polite" aria-labelledby="rogueTutorialTitle">
  <div class="rogueTutorialCoachTop"><div id="rogueTutorialProgress">Tutorial 1 / 9</div><button class="btn" id="rogueTutorialExitBtn" type="button" style="padding:3px 8px">Exit</button></div>
  <h3 id="rogueTutorialTitle">Welcome</h3>
  <div id="rogueTutorialBody"></div>
  <div id="rogueTutorialTask"></div>
  <div class="rogueTutorialActions">
    <button class="btn" id="rogueTutorialPrevBtn" type="button">Previous</button>
    <button class="btn hidden" id="rogueTutorialHelperBtn" type="button">Practice Helper</button>
    <button class="btn green" id="rogueTutorialNextBtn" type="button">Next</button>
  </div>
</div>

<script id="rogueliteInteractiveTutorialScript">
(function(){
 'use strict';
 const setup=document.getElementById('setupModal');
 const setupActions=setup?.querySelector('.modalbox > div:last-child');
 const start=document.getElementById('startBtn');
 const intro=document.getElementById('rogueTutorialIntro');
 const coach=document.getElementById('rogueTutorialCoach');
 const progress=document.getElementById('rogueTutorialProgress');
 const title=document.getElementById('rogueTutorialTitle');
 const body=document.getElementById('rogueTutorialBody');
 const task=document.getElementById('rogueTutorialTask');
 const prev=document.getElementById('rogueTutorialPrevBtn');
 const next=document.getElementById('rogueTutorialNextBtn');
 const helper=document.getElementById('rogueTutorialHelperBtn');
 let active=false,index=0,poll=null,savedSetup=null,mergeShown=false;

 // Keep the obsolete pre-roguelite tutorial permanently out of the way.
 document.getElementById('tutorialWelcome')?.classList.add('hidden');
 document.getElementById('tutorialCoach')?.classList.add('hidden');
 document.getElementById('tutorialResumeChip')?.classList.add('hidden');

 if(setupActions&&start&&!document.getElementById('setupTutorialBtn')){
   const b=document.createElement('button');
   b.className='btn';b.id='setupTutorialBtn';b.type='button';b.textContent='Play Tutorial';b.style.flex='1';
   start.insertAdjacentElement('afterend',b);
 }
 const setupTutorialBtn=document.getElementById('setupTutorialBtn');

 function captureSetup(){
   const count=Number(document.getElementById('playerCount')?.value||1);
   const players=[];
   for(let i=0;i<count;i++)players.push({name:document.getElementById(`pname${i}`)?.value||'',char:document.getElementById(`pchar${i}`)?.value||''});
   return {count,timer:document.getElementById('turnTimerSelect')?.value||'60',players};
 }
 function restoreSetup(){
   const snap=savedSetup;
   const count=document.getElementById('playerCount');
   if(count&&snap)count.value=String(snap.count||1);
   setupPlayersUI();
   if(snap){
     const timer=document.getElementById('turnTimerSelect');if(timer)timer.value=snap.timer||'60';
     (snap.players||[]).forEach((p,i)=>{let n=document.getElementById(`pname${i}`),c=document.getElementById(`pchar${i}`);if(n)n.value=p.name;if(c&&p.char)c.value=p.char});
   }
 }
 function tutorialCard(name){
   const base=(window.PRIEST||PRIEST||[]).find(c=>c.n===name);
   return base?{...base,id:`tutorial-${name.replace(/\W/g,'').toLowerCase()}-${uid()}`,empowered:false,empowerPaid:false}:null;
 }
 function seedPracticeHand(){
   const p=currentPlayer();if(!p)return;
   const names=['Quick Prayer','Smite','Smite','Divine Shield'];
   const cards=names.map(tutorialCard).filter(Boolean);
   if(cards.length>=3)p.hand=cards;
 }
 function makeLesser(base,tag='practice'){
   const d={...base,id:`tutorial-${tag}-${uid()}`,greater:false,cur:base.hp,status:{}};
   if(S?.rogue?.enabled&&typeof window.__rogueliteMutateDemon==='function')window.__rogueliteMutateDemon(d);
   d.cur=demonMaxHP(d);return d;
 }
 function seedPracticeDemon(){
   if(!S?.started)return;
   S.rooms=[[],[],[],[]];
   const base=DEMON_TYPES[0];
   if(base)S.rooms[0].push(makeLesser(base,'starter'));
 }
 function clearFocus(){document.querySelectorAll('.rogueTutorialFocus').forEach(el=>el.classList.remove('rogueTutorialFocus'))}
 function resolveTarget(step){try{return typeof step.target==='function'?step.target():document.querySelector(step.target)}catch(e){return null}}
 function focusStep(){clearFocus();const el=resolveTarget(steps[index]);if(el){el.classList.add('rogueTutorialFocus');try{el.scrollIntoView({behavior:'smooth',block:'center'})}catch(e){}}}
 function pause(){try{pauseTurnTimer(false)}catch(e){try{clearTurnTimerInterval()}catch(_){}}}
 function checkDone(step){try{return !step.check||!!step.check()}catch(e){return false}}
 function updateTask(){
   if(!active)return;
   const step=steps[index],done=checkDone(step);
   task.classList.toggle('done',done);
   task.innerHTML=step.task?`${done?'✓ ':''}${step.task}${done?'':' <small style="display:block;margin-top:4px;opacity:.72">Optional practice — Next is always available.</small>'}`:'Read this step, then continue.';
   next.disabled=false;
   next.textContent=index===steps.length-1?'Return to Setup':'Next';
   next.title=done?'Task complete — continue.':'Practice is optional — you can continue now and return with Previous.';
   helper.classList.toggle('hidden',!step.helper);
   if(step.helper)helper.textContent=step.helperLabel||'Practice Helper';
   pause();