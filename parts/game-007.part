#rogueLegacyDismiss{
  position:sticky;
  top:0;
  z-index:5;
  float:right;
  margin:0 0 8px 10px;
  min-width:72px;
  padding:5px 9px;
  font-size:10px;
}
/* Priest header order is: actions, Demon Blood, remaining stats, player, Cinders. */
#handPanel .handCharacterPriest .ritualTracker #basicBtn,
#handPanel .handCharacterPriest .ritualTracker #endBtn{
  min-width:78px !important;
