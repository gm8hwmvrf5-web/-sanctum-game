  }
  .ritualRollCard{min-width:190px !important;padding:7px 12px 8px !important;}
  .ritualRollToastNumber{font-size:42px !important;}
  #handPanel .handCharacterPriest .priestActionTop{
    display:flex !important;
    flex-wrap:nowrap !important;
    gap:4px !important;
    margin:0 0 4px !important;
  }
  #handPanel .handCharacterPriest .priestActionTop #basicBtn,
