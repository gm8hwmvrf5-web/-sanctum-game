 }
 function showStep(){
   if(!active)return;
   const step=steps[index];
   progress.textContent=`Tutorial ${index+1} / ${steps.length}`;
   title.textContent=step.title;body.innerHTML=step.body;
   prev.disabled=index===0;helper.onclick=step.helper||null;
   focusStep();updateTask();
 }
 function finishTutorial(message='Tutorial complete — choose your real run setup.'){
   active=false;mergeShown=false;window.__sanctumTutorialMode=false;window.__rogueliteTutorialSession=false;document.body.classList.remove('rogue-tutorial-active');
   if(poll){clearInterval(poll);poll=null}clearFocus();coach.classList.add('hidden');intro.classList.add('hidden');
   try{clearTurnTimerInterval()}catch(e){}
   S=freshState();
   restoreSetup();
   const cancel=document.getElementById('setupCancelBtn');if(cancel)cancel.classList.add('hidden');
   pauseTurnTimer(true);setup?.classList.remove('hidden');
   try{showGameStatus(message,'good')}catch(e){}
 }
 function prepareTarget(){
   if(!S?.started)return;
   let x=allDemons().find(x=>!x.d.greater);
   if(!x){const base=DEMON_TYPES[0];if(base){const d=makeLesser(base,'target');S.rooms[0].push(d);x={d,r:0,i:S.rooms[0].length-1}}}
   if(x){x.d.cur=1;log(`Tutorial helper: ${demonName(x.d)} is set to 1 HP so you can practice earning Demon Blood and Relic XP.`,'info');render();focusStep()}
 }
 function demonstrateMerge(){
   if(!S?.started)return;
   const base=DEMON_TYPES[0];if(!base)return;
   S.globalMergeBlock=false;S.blockNextMerge=false;S.roomMergeBlock={};S.consecrated=[false,false,false,false];
   S.rooms=[[],[],[],[]];
   const a=makeLesser(base,'merge-a'),b=makeLesser(base,'merge-b');
   S.rooms[0].push(a);S.rooms[1].push(b);
   log(`Tutorial: two matching ${base.n} cards are placed in Gateway and Hall.`,'info');
   resolveBoardDuplicateMerges();mergeShown=true;render();focusStep();updateTask();
 }

 const steps=[
  {title:'The Run at a Glance',target:'.stats',body:'This is the real play screen. Protect the <b>Altar</b>, spend shared Mana carefully, and clear floors. A roguelite cycle has <b>15 floors across 3 Acts</b>, with Bosses on Floors 5, 10, and 15.',task:null},
  {title:'Play a Priest Card',target:'#handPanel',body:'Your front two cards are immediately playable. Priest cards normally spend <b>Shared Mana</b>. For this practice hand, use <b>Quick Prayer</b> or any other card you can resolve.',task:'Play one Priest card.',check:()=>Number(S?.runStats?.cardsPlayed||0)>=1},
  {title:'Empower Matching Cards',target:'#handPanel',body:'Two matching unempowered cards can merge into one stronger <b>Empowered</b> card. Empowering itself is free; you pay the Empowered play cost only when you actually play it. The Empowered card automatically rotates to the front of the hand.',task:'Empower the two matching Smite cards.',check:()=>!!currentPlayer()?.hand?.some(c=>c.empowered)},
  {title:'Use Your Free Basic Attack',target:()=>document.getElementById('basicBtn')||document.getElementById('ritualPanel'),body:'Every Priest gets <b>one Basic Attack per turn</b>. It costs no Mana, so it is an important source of reliable damage.',task:'Use Basic Attack once.',check:()=>!!currentPlayer()?.basic},
  {title:'Spend Demon Blood on a Ritual',target:'#ritualPanel',body:'Rituals spend <b>Demon Blood</b>, not Mana. The practice Priest begins with 4 Blood so you can try one immediately. You may resolve only one Ritual each Priest turn.',task:'Resolve one Ritual.',check:()=>Number(S?.runStats?.ritualsUsed||0)>=1},
  {title:'Earn Blood and Relic XP',target:()=>document.getElementById('relicXpMeterStat')||document.getElementById('ritualPanel'),body:'Defeating a Demon awards its remaining <b>Demon Blood</b> and also grants the same amount as <b>Relic XP</b>. The first XP Relic needs 15 XP; later XP-earned Relics require 5 more each time.',task:'Defeat at least one Demon. Use the helper if you want a 1-HP practice target.',check:()=>Number(S?.defeats||0)>=1||Number(S?.rogue?.relicXp||0)>0,helper:prepareTarget,helperLabel:'Prepare 1-HP Demon'},
  {title:'End the Turn',target:()=>document.getElementById('endBtn')||document.getElementById('ritualPanel'),body:'When you are finished, press <b>End Turn</b>. In solo play that immediately leads into the Demon Phase: Demons advance toward the Altar, their abilities resolve, and the next round begins.',task:'End the turn and reach Round 2.',check:()=>Number(S?.round||1)>=2},
  {title:'Duplicate Demons Merge',target:'#boardSection',body:'Whenever <b>two copies of the same Lesser Demon</b> are on the board, they automatically become that card’s Greater form. If they were in different rooms, the Greater Demon stays in the room <b>farthest from the Altar</b>.',task:'Run the merge demonstration.',check:()=>mergeShown,helper:demonstrateMerge,helperLabel:'Show Merge Demo'},
  {title:'Relics, Cinders, and the Endless Loop',target:()=>document.querySelector('.priestRelicTopStack')||document.getElementById('handPanel'),body:'Clear rooms to choose rewards and build your Relic set. After every third Boss, your earned <b>Cinders are banked</b> and the Legacy shop opens. You can then continue with the same run and Relics into another 3 Acts at higher Ascension difficulty. This tutorial state will now be discarded.',task:null}
 ];

 function startTutorial(){
   savedSetup=captureSetup();intro.classList.add('hidden');
   document.getElementById('playerCount').value='1';setupPlayersUI();
   const n=document.getElementById('pname0'),c=document.getElementById('pchar0'),timer=document.getElementById('turnTimerSelect');
   if(n)n.value='Tutorial Priest';if(c)c.value='Exorcist';if(timer)timer.value='60';
   window.__sanctumTutorialMode=true;window.__rogueliteTutorialSession=true;
   if(!startGame()){window.__sanctumTutorialMode=false;window.__rogueliteTutorialSession=false;restoreSetup();setup?.classList.remove('hidden');return}
   active=true;index=0;mergeShown=false;document.body.classList.add('rogue-tutorial-active');
   const p=currentPlayer();if(p){p.blood=4;seedPracticeHand()}
   seedPracticeDemon();S.mana=10;render();pause();coach.classList.remove('hidden');showStep();
   poll=setInterval(()=>{if(active){updateTask();if(!document.querySelector('.rogueTutorialFocus'))focusStep()}},250);
 }

 setupTutorialBtn?.addEventListener('click',()=>{savedSetup=captureSetup();intro.classList.remove('hidden')});
 document.getElementById('rogueTutorialBackBtn')?.addEventListener('click',()=>intro.classList.add('hidden'));
 document.getElementById('rogueTutorialBeginBtn')?.addEventListener('click',startTutorial);
 document.getElementById('rogueTutorialExitBtn')?.addEventListener('click',()=>finishTutorial('Tutorial exited — your practice state was discarded.'));
 prev.addEventListener('click',()=>{if(index>0){index--;showStep()}});
 next.addEventListener('click',()=>{if(index>=steps.length-1)finishTutorial();else{index++;showStep()}});
 window.__startRogueliteTutorial=startTutorial;
})();
</script>


<style id="popupCardsMatchBoardPatch">
/* Make demon/boss popups use the same card treatment and size as on-board cards. */
#choiceModal .modalbox{width:min(940px,96vw);}
#choiceModal .choicegrid.damageTargetGrid{grid-template-columns:repeat(auto-fit,150px) !important;justify-content:center !important;gap:8px !important;}
#choiceModal .choice.damageTargetCard{
  width:150px !important;
  min-height:0 !important;
  box-sizing:border-box !important;
  margin:0 !important;
  padding:5px !important;
  overflow:hidden !important;
  border:1px solid #573838 !important;
  border-radius:7px !important;
  background:#201212 !important;
  color:#eadbbf !important;
  box-shadow:none !important;
  display:flex !important;
  flex-direction:column !important;
  gap:6px !important;
  cursor:pointer !important;
  text-align:left !important;
  transform:none !important;
}
#choiceModal .choice.damageTargetCard.greater{background:#2a1710 !important;border-color:#b46b2d !important;}
#choiceModal .choice.damageTargetCard.bossTarget{width:150px !important;background:#270d0d !important;border-color:#9e3a30 !important;}
#choiceModal .choice.damageTargetCard:hover{filter:brightness(1.08) !important;transform:none !important;}
#choiceModal .choice.damageTargetCard .demonArtWrap{height:92px !important;border:1px solid #8b6737 !important;border-radius:6px !important;box-shadow:inset 0 0 14px rgba(0,0,0,.45) !important;}
#choiceModal .choice.damageTargetCard .demonBody{min-width:0 !important;flex:1 !important;display:flex !important;flex-direction:column !important;gap:4px !important;}
#choiceModal .choice.damageTargetCard .name{color:#f1d5a4 !important;font-weight:bold !important;line-height:1.1 !important;font-size:11px !important;}
#choiceModal .choice.damageTargetCard .demonStats{display:flex !important;flex-wrap:wrap !important;gap:3px 4px !important;font-size:9.5px !important;line-height:1.2 !important;}
#choiceModal .choice.damageTargetCard .demonStats span{display:inline-block !important;padding:1px 4px !important;border:1px solid #5e4a35 !important;border-radius:999px !important;background:rgba(0,0,0,.18) !important;}
#choiceModal .choice.damageTargetCard .targetRoomTag{color:#ad9b7d !important;font-size:8px !important;letter-spacing:.55px !important;text-transform:uppercase !important;line-height:1.15 !important;}
#choiceModal .choice.damageTargetCard .familyTag{display:inline-block !important;align-self:flex-start !important;margin:0 !important;padding:1px 5px !important;border:1px solid #614d33 !important;border-radius:999px !important;color:#cdb783 !important;font-size:8px !important;letter-spacing:.6px !important;text-transform:uppercase !important;}
#choiceModal .choice.damageTargetCard .abilityText{font-size:10px !important;line-height:1.32 !important;color:#e5d9c7 !important;margin-top:1px !important;white-space:normal !important;overflow-wrap:anywhere !important;}
#choiceModal .choice.damageTargetDone{width:150px !important;min-height:118px !important;display:grid !important;place-items:center !important;text-align:center !important;border:1px dashed #7d6744 !important;background:#19140f !important;color:#e3c88e !important;font-weight:700 !important;border-radius:7px !important;}
#cardRevealModal .modalbox{width:min(980px,96vw);}
#cardRevealModal .deckpair{display:grid !important;grid-template-columns:150px auto 150px !important;gap:8px !important;justify-content:center !important;align-items:start !important;border:none !important;background:transparent !important;padding:0 !important;}
#cardRevealModal .deckface{width:150px !important;min-width:150px !important;background:#201212 !important;border:1px solid #573838 !important;border-radius:7px !important;padding:5px !important;display:flex !important;flex-direction:column !important;box-sizing:border-box !important;}
#cardRevealModal .deckface.greater{background:#2a1710 !important;border-color:#b46b2d !important;}
#cardRevealModal .deckface img{height:92px !important;max-height:none !important;aspect-ratio:auto !important;object-fit:contain !important;object-position:center center !important;padding:0 !important;margin-bottom:6px !important;border-radius:6px !important;border:1px solid #8b6737 !important;}
#cardRevealModal .deckface b{color:#f1d5a4 !important;line-height:1.1 !important;font-size:11px !important;}
#cardRevealModal .deckface small{color:#cdb783 !important;font-size:8px !important;line-height:1.25 !important;}
#cardRevealModal .deckface p{font-size:10px !important;line-height:1.32 !important;color:#e5d9c7 !important;margin:5px 0 0 !important;}
#cardRevealModal .deckarrow{align-self:center !important;color:#d4aa55 !important;font-size:20px !important;margin-top:38px !important;}
@media(max-width:700px){
  #choiceModal .choicegrid.damageTargetGrid{grid-template-columns:repeat(auto-fit,145px) !important;}
  #choiceModal .choice.damageTargetCard, #choiceModal .choice.damageTargetDone{width:145px !important;}
  #cardRevealModal .deckpair{grid-template-columns:145px auto 145px !important;}
  #cardRevealModal .deckface{width:145px !important;min-width:145px !important;}
}
</style>

<style id="popupCardArtworkExactMatchPatch">
/* Popup demon faces use the same compact art window and full-creature framing as board cards. */
#choiceModal .choice.damageTargetCard .demonArt{
  display:block !important;
  width:100% !important;
  height:100% !important;
  object-fit:contain !important;
  object-position:center center !important;
  margin:0 !important;
  transform:scale(.96) !important;
  transform-origin:center center !important;
}
#choiceModal .choice.damageTargetCard .demonArtWrap,
#cardRevealModal .deckface img{
  background:radial-gradient(circle at 50% 40%,#241714 0%,#100b0b 72%,#070606 100%) !important;
}
#choiceModal .choice.damageTargetCard.bossTarget .demonArtWrap{height:92px !important;}
</style>
<style id="iphoneLandscapeDedicatedStyles">
/* Dedicated iPhone / short-phone landscape layout. Desktop and portrait remain unchanged. */
@media (orientation:landscape) and (max-height:520px) and (max-width:1000px){
  html,body{
    width:100% !important;
    min-height:100% !important;
    overflow-x:hidden !important;
    overflow-y:auto !important;
    -webkit-text-size-adjust:100% !important;
    overscroll-behavior-y:auto !important;
  }
  body{
    margin:0 !important;
    padding:0 !important;
    touch-action:manipulation !important;
  }
  .app{
    width:100% !important;
    max-width:none !important;
    margin:0 !important;
    padding:
      max(4px,env(safe-area-inset-top))
      max(5px,env(safe-area-inset-right))
      calc(48px + env(safe-area-inset-bottom))
      max(5px,env(safe-area-inset-left)) !important;
  }

  /* Five-room board stays visible as a single landscape strip. */
  #boardSection.board{
    display:grid !important;
    grid-template-columns:repeat(5,minmax(0,1fr)) !important;
    gap:4px !important;
    overflow:visible !important;
    scroll-snap-type:none !important;
    padding:0 !important;
    margin:0 !important;
  }
  #boardSection .room{
    flex:initial !important;
    min-width:0 !important;
    width:auto !important;
    min-height:138px !important;
    height:138px !important;
    padding:3px !important;
    border-radius:7px !important;
    overflow:hidden !important;
  }
  #boardSection .room.boss{grid-column:auto !important;}
  #boardSection .room h3{
    margin:0 0 2px !important;
    font-size:10px !important;
    line-height:1.05 !important;
    letter-spacing:.6px !important;
  }
  #boardSection .roomMeta{
    min-height:20px !important;
    margin:0 0 2px !important;
    gap:2px !important;
    justify-content:center !important;
  }
  #boardSection .roomMeta .cap{display:none !important;}
  #boardSection .roomMeta .tag{
    font-size:6.5px !important;
    padding:1px 3px !important;
    margin:0 !important;
  }
  #boardSection .roomMeta .btn{
    min-height:20px !important;
    height:20px !important;
    padding:1px 4px !important;
    font-size:7px !important;
    line-height:1 !important;
    border-radius:5px !important;
  }
  #boardSection .demons{
    display:grid !important;
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
    gap:2px !important;
  }
  #boardSection .demon{
    min-width:0 !important;
    min-height:0 !important;
    height:52px !important;
    padding:2px !important;
    gap:1px !important;
    border-radius:5px !important;
    overflow:hidden !important;
  }
  #boardSection .demonArtWrap{
    height:21px !important;
    min-height:21px !important;
    border-radius:3px !important;
    margin:0 !important;
  }
  #boardSection .demonArt{
    width:100% !important;
    height:100% !important;
    min-height:0 !important;
    margin:0 !important;
    object-fit:contain !important;
    object-position:center center !important;
  }
  #boardSection .demonBody{gap:0 !important;min-width:0 !important;}
  #boardSection .demon .name{
    font-size:7px !important;
    line-height:1 !important;
    white-space:nowrap !important;
    overflow:hidden !important;
    text-overflow:ellipsis !important;
  }
  #boardSection .demonStats{
    display:flex !important;
    flex-wrap:nowrap !important;
    gap:1px !important;
    font-size:6.5px !important;
    line-height:1 !important;
    overflow:hidden !important;
  }
  #boardSection .demonStats span{padding:0 2px !important;white-space:nowrap !important;}
  #boardSection .abilityText,
  #boardSection .manualAbility,
  #boardSection .familyTag{display:none !important;}
  #boardSection .bossCard{padding:3px !important;border-radius:5px !important;}
  #boardSection .bossArt{
    height:66px !important;
    aspect-ratio:auto !important;
    object-fit:contain !important;
    margin-bottom:2px !important;
  }
  #boardSection .bossName{font-size:8px !important;line-height:1 !important;}
  #boardSection .bossSubtitle{font-size:6px !important;margin:1px 0 !important;}
  #boardSection .bossAbilityMini{display:none !important;}
  #boardSection .room.boss .cap{font-size:7px !important;line-height:1.15 !important;margin:2px !important;}

  /* One thin, sticky status row. */
  #topStatusBar.stats{
    position:sticky !important;
    top:0 !important;
    z-index:45 !important;
    display:grid !important;
    grid-template-columns:minmax(190px,2.25fr) repeat(5,minmax(54px,1fr)) !important;
    gap:3px !important;
    margin:4px 0 !important;
    padding:3px !important;
    background:rgba(8,8,10,.94) !important;
    border:1px solid #4e3c27 !important;
    border-radius:7px !important;
    backdrop-filter:blur(10px) !important;
  }
  #topStatusBar .stat{
    min-width:0 !important;
    min-height:34px !important;
    height:34px !important;
    margin:0 !important;
    padding:2px 3px !important;
    border-radius:5px !important;
    overflow:hidden !important;
  }
  #topStatusBar .stat b{
    font-size:12px !important;
    line-height:1 !important;
    margin:1px 0 !important;
  }
  #topStatusBar .stat>span{
    font-size:6px !important;
    line-height:1 !important;
    letter-spacing:.3px !important;
    white-space:nowrap !important;
  }
  #topStatusBar .runProgressStat{padding:2px 5px !important;}
  #topStatusBar .runProgressStat>span{display:none !important;}
  #topStatusBar .runProgressPair{
    height:100% !important;
    gap:4px !important;
    align-items:center !important;
  }
  #topStatusBar .runProgressChunk{min-width:0 !important;}
  #topStatusBar .runProgressChunk em{font-size:5.8px !important;line-height:1 !important;}
  #topStatusBar .runProgressChunk strong{font-size:9px !important;line-height:1.05 !important;}
  #topStatusBar .runProgressDivider{height:20px !important;}
  #rogueHud{display:none !important;}

  /* Compact hand + Priest dashboard side by side. */
  #handPanel{
    margin:4px 0 !important;
    padding:5px !important;
    border-radius:8px !important;
  }
  #handPanel .handCharacterStage{
    display:grid !important;
    grid-template-columns:minmax(0,61%) minmax(265px,39%) !important;
    gap:6px !important;
    align-items:start !important;
  }
  #handPanel .handCharacterCards{
    display:block !important;
    min-width:0 !important;
    align-self:start !important;
    grid-column:1 !important;
    grid-row:1 !important;
  }
  #handPanel .handCharacterPriest{
    grid-column:2 !important;
    grid-row:1 !important;
    width:auto !important;
    justify-self:stretch !important;
  }
  #handPanel .handCharacterPriest.panel{
    min-width:0 !important;
    margin:0 !important;
    padding:5px !important;
    border-radius:7px !important;
  }
  #handPanel .playerHeader{
    grid-template-columns:54px minmax(0,1fr) !important;
    gap:5px !important;
    align-items:start !important;
  }
  #handPanel .portrait{
    width:54px !important;
    height:54px !important;
    border-radius:6px !important;
  }
  #handPanel .handCharacterPriest h2{font-size:13px !important;margin:0 0 3px !important;}
  #handPanel .playerMeta{gap:2px !important;}
  #handPanel .badge{font-size:7.5px !important;padding:2px 4px !important;}
  #handPanel .handCharacterPriest .ritualTracker{
    gap:3px !important;
    padding:0 0 4px !important;
    margin:0 0 4px !important;
    flex-wrap:wrap !important;
  }
  #handPanel .handCharacterPriest .ritualTracker #basicBtn,
  #handPanel .handCharacterPriest .ritualTracker #endBtn{
    width:70px !important;
    min-width:70px !important;
    max-width:70px !important;
    min-height:34px !important;
    height:34px !important;
    padding:3px 4px !important;
    font-size:8.4px !important;
  }
  #handPanel .handCharacterPriest .ritualTracker .trackerAction{
    min-height:28px !important;
    padding:3px 5px !important;
    font-size:7.8px !important;
  }
  #handPanel .playerTurnTag{
    width:100% !important;
    margin:0 !important;
    padding:2px 0 !important;
    border:0 !important;
    gap:3px !important;
  }
  #handPanel .playerTurnTag b{font-size:8px !important;}
  #handPanel .playerTurnTag small{font-size:7px !important;}
  #handPanel .ritualBloodGauge{min-height:8px !important;height:8px !important;}
  #handPanel .relicXpStrip{min-height:7px !important;height:7px !important;}

  /* Keep the four-card fan, but size it for a landscape phone. */
  #handContent .handCarousel.twoFrontMode.fourVisibleMode{
    width:100% !important;
    max-width:500px !important;
    grid-template-columns:28px minmax(0,1fr) 28px !important;
    gap:2px !important;
    left:0 !important;
    margin:0 auto !important;
  }
  #handContent .handCarousel .carouselNav{
    width:28px !important;
    min-width:28px !important;
    height:42px !important;
    min-height:42px !important;
    font-size:20px !important;
    padding:0 !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack{
    position:relative !important;
    display:block !important;
    width:430px !important;
    max-width:100% !important;
    min-height:218px !important;
    height:218px !important;
    padding:0 !important;
    margin:0 auto !important;
    overflow:visible !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-right{
    position:absolute !important;
    top:0 !important;
    display:flex !important;
    width:158px !important;
    min-width:158px !important;
    max-width:158px !important;
    min-height:208px !important;
    max-height:208px !important;
    padding:5px 5px 34px !important;
    font-size:8.5px !important;
    overflow:hidden !important;
    transform:none !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-center{left:50px !important;}
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-right{left:216px !important;}
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-left,
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-right{
    position:absolute !important;
    top:8px !important;
    display:flex !important;
    width:126px !important;
    min-width:126px !important;
    max-width:126px !important;
    min-height:188px !important;
    max-height:188px !important;
    padding:4px !important;
    overflow:hidden !important;
    opacity:.54 !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-left{
    left:0 !important;
    transform:scale(.86) rotate(-2deg) !important;
    transform-origin:right center !important;
  }
  #handContent .handCarousel.twoFrontMode.fourVisibleMode .hand.carouselTrack > .card.carouselCard.is-back-right{
    left:304px !important;
    transform:scale(.86) rotate(2deg) !important;
    transform-origin:left center !important;
  }
  #handContent .hand.carouselTrack > .card .cardArt,
