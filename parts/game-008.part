  #handContent .handCarousel .carouselCount{padding:1px 5px !important;}
  #handContent .relicSummary,#handContent>.notice{font-size:8px !important;margin:2px auto !important;padding:4px !important;}

  /* Rituals and log remain side by side instead of switching to portrait stacking. */
  #mainSection.ritualLogStage{
    display:grid !important;
    grid-template-columns:minmax(0,1.65fr) minmax(220px,.72fr) !important;
    gap:5px !important;
